@model AmlScreening.Domain.Entities.Compliance.CustomerKycResult
@{ ViewData["Title"] = "KYC Result"; }
<h1>KYC result: @Model.CustomerReference</h1>
<dl>
 <dt>Score / level</dt><dd>@Model.RiskScore / @Model.RiskLevel</dd>
 <dt>Decision</dt><dd>@Model.Decision</dd>
 <dt>Calculated (UTC)</dt><dd>@Model.CalculatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</dd>
 <dt>Correlation</dt><dd>@Model.CorrelationId</dd>
 <dt>Submission channel</dt><dd>@Model.SubmissionChannel</dd>
</dl>
<h2>AML screening result</h2>
<details><summary>Original customer request (sensitive information)</summary>
<pre style="white-space:pre-wrap;overflow-wrap:anywhere">@(Model.RequestJson ?? "Not captured for this legacy result.")</pre></details>
<pre style="white-space:pre-wrap;overflow-wrap:anywhere">@Model.AmlResultJson</pre>
<h2>Factor breakdown</h2>
<pre style="white-space:pre-wrap;overflow-wrap:anywhere">@Model.FactorsJson</pre>
<a asp-action="Index" asp-route-customerId="@Model.CustomerId">Back to history</a>
