@model IReadOnlyList<AmlScreening.Domain.Entities.Compliance.CustomerKycResult>
@{ ViewData["Title"] = "Customer KYC History"; }
<h1>Customer KYC History</h1>
<p>Latest 100 permitted results. Each row is one completed screening.</p>
<table class="table table-striped">
 <thead><tr><th>Reference</th><th>Calculated (UTC)</th><th>Score</th><th>Risk level</th><th>Decision</th><th></th></tr></thead>
 <tbody>
 @foreach (var item in Model)
 {
  <tr><td>@item.CustomerReference</td><td>@item.CalculatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
   <td>@item.RiskScore</td><td>@item.RiskLevel</td><td>@item.Decision</td>
   <td><a asp-action="Details" asp-route-id="@item.Id">Details</a></td></tr>
 }
 </tbody>
</table>
@if (Model.Count == 0) { <p>No permitted KYC results found.</p> }
