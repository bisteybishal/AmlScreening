@model IReadOnlyList<AmlScreening.Application.Models.AuditLogItem>
@{
    ViewData["Title"] = "Audit Logs";
}

@section Styles {
    <link rel="stylesheet" href="~/css/aml-records.css" asp-append-version="true" />
}

<section class="records-heading">
    <div><h1>Audit Logs</h1><p>Recent activity visible to your client account.</p></div>
</section>

<section class="records-table-card">
    <div class="table-responsive">
        <table class="records-table">
            <thead><tr><th>Date</th><th>User</th><th>Action</th><th>Entity</th><th>Reference</th><th>Details</th></tr></thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="6">No audit activity found.</td></tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CreatedDate.ToString("dd MMM yyyy HH:mm:ss") UTC</td>
                        <td>@item.Username</td>
                        <td>@item.Action</td>
                        <td>@item.EntityType</td>
                        <td>@item.EntityId</td>
                        <td>@item.Details</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>
