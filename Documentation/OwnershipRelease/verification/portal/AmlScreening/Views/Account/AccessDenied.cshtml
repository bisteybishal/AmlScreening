@{
    ViewData["Title"] = "Access Denied";
}

<section style="max-width:620px;margin:45px auto;padding:32px;text-align:center;background:#fff;border:1px solid var(--line);border-radius:10px">
    <span style="width:58px;height:58px;margin:0 auto 15px;display:grid;place-items:center;border-radius:50%;background:#fee7e7;color:#d93434;font-size:25px"><i class="bi bi-shield-lock"></i></span>
    <h1 style="font-size:22px;color:#102f49">Access denied</h1>
    <p style="font-size:13px;color:var(--muted)">Only an administrator can manage portal users.</p>
    <a class="btn btn-outline-secondary mt-2" asp-controller="Dashboard" asp-action="Index">Return to Dashboard</a>
</section>
