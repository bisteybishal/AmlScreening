@model AmlScreening.Portal.ViewModels.AmlRecordInputModel

<input asp-for="Id" type="hidden" />
<input asp-for="RowVersion" type="hidden" />
<div asp-validation-summary="ModelOnly" class="records-validation-summary"></div>

<div class="record-form-grid">
    <div class="field">
        <label asp-for="RecordType"></label>
        <select asp-for="RecordType">
            @foreach (var item in Model.RecordTypes)
            {
                <option value="@item">@item</option>
            }
        </select>
        <span asp-validation-for="RecordType"></span>
    </div>
    <div class="field">
        <label asp-for="FullName"></label>
        <input asp-for="FullName" placeholder="Enter the complete name" />
        <span asp-validation-for="FullName"></span>
    </div>
    <div class="field">
        <label asp-for="DateOfBirth"></label>
        <input asp-for="DateOfBirth" type="date" />
        <span asp-validation-for="DateOfBirth"></span>
    </div>
    <div class="field">
        <label asp-for="Country"></label>
        <select asp-for="Country">
            <option value="">Select a country</option>
            @foreach (var item in Model.Countries)
            {
                <option value="@item">@item</option>
            }
        </select>
        <span asp-validation-for="Country"></span>
    </div>
    <div class="field">
        <label asp-for="Nationality"></label>
        <select asp-for="Nationality">
            <option value="">Select a nationality</option>
            @foreach (var item in Model.Nationalities)
            {
                <option value="@item">@item</option>
            }
        </select>
        <span asp-validation-for="Nationality"></span>
    </div>
    <div class="field">
        <label asp-for="ReferenceNo"></label>
        <input asp-for="ReferenceNo" placeholder="e.g. AML-10255" />
        <span asp-validation-for="ReferenceNo"></span>
    </div>
    <div class="field full">
        <label asp-for="SourceName"></label>
        <select asp-for="SourceName">
            <option value="">Select a source</option>
            @foreach (var item in Model.Sources)
            {
                <option value="@item">@item</option>
            }
        </select>
        <span asp-validation-for="SourceName"></span>
    </div>
    <div class="field full">
        <label asp-for="Remarks"></label>
        <textarea asp-for="Remarks" rows="4" placeholder="Add relevant notes or screening details"></textarea>
        <span asp-validation-for="Remarks"></span>
    </div>
    <label class="active-switch full">
        <input asp-for="IsActive" />
        <span></span><strong>Active record</strong><small>Include this record in active screening.</small>
    </label>
</div>
