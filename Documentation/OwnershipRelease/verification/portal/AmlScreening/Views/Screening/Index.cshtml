@{
    ViewData["Title"] = "Screening";
}

@section Styles {
    <link rel="stylesheet" href="~/css/screening.css" asp-append-version="true" />
}

<section class="screening-hero">
    <div class="screening-eyebrow">AML NAME LOOKUP</div>
    <h1>Start with a name.<br /><span>Search your permitted records.</span></h1>
    <p class="screening-intro">Search up to three people or companies. Enter one complete name per box.</p>
    <form id="screening-search-form" asp-controller="Screening" asp-action="Search"
          method="post" class="screening-form" role="search">
        @Html.AntiForgeryToken()
        @for (var index = 0; index < 3; index++)
        {
            <label for="screening-name-@index" class="screening-label">
                Name @(index + 1) @(index == 0 ? "" : "(optional)")
            </label>
            <div class="screening-search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input id="screening-name-@index" name="Names" type="search"
                       placeholder="Individual or company name" autocomplete="off" maxlength="200"
                       aria-controls="screening-results" aria-describedby="screening-status" />
                @if (index == 0)
                {
                    <button type="submit">Search</button>
                }
            </div>
        }
    </form>
    <p class="screening-note">Name matches need review; they do not confirm identity. This lookup is not a clearance decision.</p>
</section>
<p id="screening-status" class="live-search-status" role="status" aria-live="polite">Type at least one character to start.</p>
<div id="screening-results" aria-busy="false"></div>

@section Scripts {
    <script src="~/js/screening.js" asp-append-version="true"></script>
}
