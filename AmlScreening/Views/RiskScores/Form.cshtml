@model AmlScreening.Portal.ViewModels.RiskRuleEditViewModel
@{
    var title = Model.Id == 0 ? "Add Risk Score" : "Edit Risk Score";
    ViewData["Title"] = title;
}
@section Styles {
    <link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/risk-scoring.css" asp-append-version="true" />
}

<section class="workflow-heading">
    <div>
        <h1>@title</h1>
        <p>@Model.ValueDescription</p>
    </div>
</section>

<section class="workflow-panel workflow-form-panel risk-editor">
    <p>Save your changes, then review and apply them from the list.</p>
    <form asp-action="@(Model.Id == 0 ? "Add" : "Edit")" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="FactorCode" type="hidden" />
        <input asp-for="RowVersion" type="hidden" />
        <div asp-validation-summary="All" class="workflow-message error"></div>
        <div class="workflow-form-grid one-column">
            <div>
                <label asp-for="ValueCode">Matching code</label>
                <input asp-for="ValueCode" maxlength="100" placeholder="For example NEPAL, SALARY, or DEFAULT" />
                <small>Use the same code as the input sent for scoring. DEFAULT handles unlisted values.</small>
            </div>
            <div><label asp-for="ValueName">@Model.ValueDescription name</label><input asp-for="ValueName" maxlength="200" /></div>
            @if (Model.ValueType is "NUMBER" or "NUMERIC")
            {
                <div><label asp-for="MinimumValue">From (inclusive)</label><input asp-for="MinimumValue" type="number" min="0" step="0.01" /></div>
                <div><label asp-for="MaximumValue">To (inclusive)</label><input asp-for="MaximumValue" type="number" min="0" step="0.01" /><small>Leave maximum blank for no upper limit. Amounts are NPR; receiver counts are whole numbers. Ranges are ignored for DEFAULT.</small></div>
            }
            <div>
                <label asp-for="Score">Score (0–100)</label>
                <input asp-for="Score" type="number" min="0" max="100" />
                <span asp-validation-for="Score"></span>
            </div>
            <div>
                <label asp-for="Remarks">Explanation</label>
                <textarea asp-for="Remarks" rows="5" placeholder="Explain why this value has this score"></textarea>
                <span asp-validation-for="Remarks"></span>
            </div>
        </div>
        <div class="workflow-form-actions">
            <a asp-action="Index" asp-route-factorCode="@Model.FactorCode">Cancel</a>
            <button class="workflow-primary" type="submit"><i class="bi bi-check2"></i> Save changes</button>
        </div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
