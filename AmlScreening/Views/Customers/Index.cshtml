@model IReadOnlyList<AmlScreening.Domain.Entities.Compliance.Customer>
@{ ViewData["Title"] = "Customers"; }
@section Styles { <link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" /> }

<section class="workflow-heading">
    <div><h1>Customer/KYC Profiles</h1><p>View customer identity and baseline risk information received through the AML API.</p></div>
</section>
<partial name="_WorkflowMessages" />
<section class="workflow-panel">
    <div class="workflow-panel-title"><h2>Customers</h2><span>@Model.Count records</span></div>
    <div class="table-responsive"><table class="workflow-table">
        <thead><tr><th>Reference</th><th>Customer</th><th>Country</th><th>PEP</th><th>Risk</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @if (Model.Count == 0) { <tr><td colspan="7" class="workflow-empty">No customers have been received from the AML API.</td></tr> }
        @foreach (var item in Model)
        {
            <tr><td><strong>@item.CustomerReference</strong></td><td>@item.FullName<small>@item.Occupation</small></td><td>@item.Country<small>@item.Nationality</small></td><td>@(item.IsPep ? "Yes" : "No")</td><td><span class="risk-pill @item.RiskLevel.ToLowerInvariant()">@item.RiskLevel (@item.RiskScore)</span></td><td>@(item.IsActive ? "Active" : "Inactive")</td><td><a asp-action="Details" asp-route-id="@item.Id">View</a></td></tr>
        }
        </tbody>
    </table></div>
</section>
