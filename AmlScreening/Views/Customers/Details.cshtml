@model AmlScreening.Domain.Entities.Compliance.Customer
@{
    ViewData["Title"] = "Customer Details";
}
@section Styles {
    <link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" />
}

<section class="workflow-heading">
    <div>
        <h1>@Model.FullName</h1>
        <p>Customer reference: @Model.CustomerReference</p>
    </div>
    <a class="workflow-secondary" asp-action="Index">Back</a>
</section>

<partial name="_WorkflowMessages" />

<div class="workflow-two-column">
    <section class="workflow-panel">
        <div class="workflow-panel-title"><h2>Identity</h2></div>
        <dl class="workflow-details">
            <dt>Full name</dt><dd>@Model.FullName</dd>
            <dt>Date of birth</dt><dd>@(Model.DateOfBirth?.ToString("dd MMM yyyy") ?? "Not provided")</dd>
            <dt>Country</dt><dd>@Model.Country</dd>
            <dt>Nationality</dt><dd>@Model.Nationality</dd>
            <dt>Occupation</dt><dd>@(string.IsNullOrWhiteSpace(Model.Occupation) ? "Not provided" : Model.Occupation)</dd>
            <dt>Source of funds</dt><dd>@(string.IsNullOrWhiteSpace(Model.SourceOfFunds) ? "Not provided" : Model.SourceOfFunds)</dd>
        </dl>
    </section>

    <section class="workflow-panel">
        <div class="workflow-panel-title"><h2>Compliance profile</h2></div>
        <dl class="workflow-details">
            <dt>PEP</dt><dd>@(Model.IsPep ? "Yes" : "No")</dd>
            <dt>Risk score</dt><dd>@Model.RiskScore / 100</dd>
            <dt>Risk level</dt><dd><span class="risk-pill @Model.RiskLevel.ToLowerInvariant()">@Model.RiskLevel</span></dd>
            <dt>Status</dt><dd>@(Model.IsActive ? "Active" : "Inactive")</dd>
            <dt>Received</dt><dd>@Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
            <dt>Last updated</dt><dd>@(Model.UpdatedDate?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "Not updated")</dd>
        </dl>
    </section>
</div>
