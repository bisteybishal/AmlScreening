@model AmlScreening.Portal.ViewModels.AmlRecordInputModel
@{
    ViewData["Title"] = "Add AML Record";
}

@section Styles {
    <link rel="stylesheet" href="~/css/aml-records.css" asp-append-version="true" />
}

<section class="record-editor-heading">
    <a asp-controller="AmlRecords" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to AML Records</a>
    <h1>Add AML Record</h1>
    <p>Create a new person, entity, or vessel watchlist record.</p>
</section>

<section class="record-editor-card">
    <div class="record-editor-card-title"><span><i class="bi bi-shield-plus"></i></span><div><h2>New record details</h2><p>Complete the required information, then save the record.</p></div></div>
    <form asp-controller="AmlRecordAdd" asp-action="Index" method="post">
        @Html.AntiForgeryToken()
        <partial name="_AmlRecordForm" model="Model" />
        <div class="record-editor-actions">
            <a class="records-secondary-button" asp-controller="AmlRecords" asp-action="Index">Cancel</a>
            <button class="records-primary-button" type="submit"><i class="bi bi-check2"></i> Add Record</button>
        </div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
