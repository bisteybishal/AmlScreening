@model AmlScreening.Domain.Entities.Compliance.ComplianceCase
@{ ViewData["Title"] = "Case Details"; }
@section Styles { <link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" /> }
<section class="workflow-heading"><div><h1>@Model.CaseReference</h1><p>Transaction #@Model.TransactionId · Alert #@Model.AlertId</p></div><a class="workflow-secondary" asp-action="Index">Back to Cases</a></section>
<partial name="_WorkflowMessages" />
<div class="workflow-two-column"><section class="workflow-panel"><div class="workflow-panel-title"><h2>Case Summary</h2></div><dl class="workflow-details"><dt>Status</dt><dd>@Model.Status</dd><dt>Assigned user</dt><dd>@(Model.AssignedUserId?.ToString() ?? "Unassigned")</dd><dt>Disposition</dt><dd>@(Model.Disposition ?? "Not set")</dd><dt>Created</dt><dd>@Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd><dt>Closed</dt><dd>@(Model.ClosedDate?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "Open")</dd></dl><a asp-controller="Transactions" asp-action="Details" asp-route-id="@Model.TransactionId">View transaction evidence</a></section>
@if (User.HasClaim(AppPermissions.ClaimType, AppPermissions.Cases.Manage)) { <section class="workflow-panel workflow-form-panel"><div class="workflow-panel-title"><h2>Investigation Update</h2></div><form asp-action="Update" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@Model.Id" /><div class="workflow-form-grid one-column"><div><label>Status</label><select name="Status"><option>ASSIGNED</option><option>INVESTIGATION</option><option>REQUEST_INFORMATION</option><option>ESCALATED</option><option>CLEARED</option><option>REJECTED</option><option>STR_SAR</option><option>CLOSED</option></select></div><div><label>Disposition</label><input name="Disposition" value="@Model.Disposition" placeholder="Reason for the case decision" /></div><div><label>Investigation notes</label><textarea name="Notes" rows="7">@Model.Notes</textarea></div></div><div class="workflow-form-actions"><button class="workflow-primary" type="submit">Save Investigation</button></div></form></section> }
</div>
