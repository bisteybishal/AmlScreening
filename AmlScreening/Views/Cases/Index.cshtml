@model IReadOnlyList<AmlScreening.Domain.Entities.Compliance.ComplianceCase>
@{ ViewData["Title"] = "Compliance Cases"; }
@section Styles { <link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" /> }
<section class="workflow-heading"><div><h1>Investigation Cases</h1><p>Assign, investigate, disposition and close AML review cases.</p></div></section>
<partial name="_WorkflowMessages" />
<section class="workflow-panel"><div class="workflow-panel-title"><h2>Case Queue</h2><span>@Model.Count cases</span></div><div class="table-responsive"><table class="workflow-table"><thead><tr><th>Case</th><th>Transaction</th><th>Status</th><th>Assigned User</th><th>Disposition</th><th>Created</th><th></th></tr></thead><tbody>
@if (Model.Count == 0) { <tr><td colspan="7" class="workflow-empty">No investigation cases have been created.</td></tr> }
@foreach (var item in Model) { <tr><td><strong>@item.CaseReference</strong><small>Alert #@item.AlertId</small></td><td>#@item.TransactionId</td><td>@item.Status</td><td>@(item.AssignedUserId?.ToString() ?? "Unassigned")</td><td>@(item.Disposition ?? "-")</td><td>@item.CreatedDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td><a asp-action="Details" asp-route-id="@item.Id">Open</a></td></tr> }
</tbody></table></div></section>
