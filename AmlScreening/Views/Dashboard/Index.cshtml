@model AmlScreening.Portal.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="dashboard-heading">
    <div>
        <h1>Welcome Back, @Model.FullName! <span>👋</span></h1>
        <p>Here’s what’s happening with your AML screening system today.</p>
    </div>
    <div class="date-chip"><i class="bi bi-calendar3"></i><span id="currentDate"></span></div>
</section>

@if (User.HasClaim(AppPermissions.ClaimType, AppPermissions.TransactionsView))
{
    <section class="metric-grid" aria-label="AML decision workflow summary">
        <article class="metric-card teal"><div class="metric-top"><span class="metric-icon"><i class="bi bi-arrow-left-right"></i></span><div><span class="metric-label">Transactions</span><strong>@Model.TransactionCount</strong></div></div></article>
        <article class="metric-card amber"><div class="metric-top"><span class="metric-icon"><i class="bi bi-hourglass-split"></i></span><div><span class="metric-label">Under Review</span><strong>@Model.ReviewCount</strong></div></div></article>
        <article class="metric-card red"><div class="metric-top"><span class="metric-icon"><i class="bi bi-slash-octagon"></i></span><div><span class="metric-label">Blocked</span><strong>@Model.BlockCount</strong></div></div></article>
        <article class="metric-card amber"><div class="metric-top"><span class="metric-icon"><i class="bi bi-exclamation-triangle"></i></span><div><span class="metric-label">Open Alerts</span><strong>@Model.OpenAlertCount</strong></div></div></article>
        <article class="metric-card teal"><div class="metric-top"><span class="metric-icon"><i class="bi bi-folder2-open"></i></span><div><span class="metric-label">Open Cases</span><strong>@Model.OpenCaseCount</strong></div></div></article>
    </section>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
    </div>
}

<section class="metric-grid" aria-label="AML record summary">
    <article class="metric-card teal">
        <div class="metric-top"><span class="metric-icon"><i class="bi bi-file-earmark-text-fill"></i></span><div><span class="metric-label">Total Records</span><strong>@Model.Summary.TotalRecords.ToString("N0")</strong></div></div>
    </article>
    <article class="metric-card green">
        <div class="metric-top"><span class="metric-icon"><i class="bi bi-shield-fill-check"></i></span><div><span class="metric-label">Active Records</span><strong>@Model.Summary.ActiveRecords.ToString("N0")</strong></div></div>
    </article>
    <article class="metric-card amber">
        <div class="metric-top"><span class="metric-icon"><i class="bi bi-person-fill"></i></span><div><span class="metric-label">Individuals</span><strong>@Model.Summary.IndividualRecords.ToString("N0")</strong></div></div>
    </article>
    <article class="metric-card red">
        <div class="metric-top"><span class="metric-icon"><i class="bi bi-buildings-fill"></i></span><div><span class="metric-label">Entities</span><strong>@Model.Summary.EntityRecords.ToString("N0")</strong></div></div>
    </article>
    <article class="metric-card teal">
        <div class="metric-top"><span class="metric-icon"><i class="bi bi-globe2"></i></span><div><span class="metric-label">Countries Covered</span><strong>@Model.Summary.CountriesCovered.ToString("N0")</strong></div></div>
    </article>
</section>

<section class="dashboard-grid dashboard-grid-single">
    <article class="panel activity-panel">
        <div class="panel-header">
            <h2>Recent AML Records</h2>
            @if (User.HasClaim(AmlScreening.Application.Security.AppPermissions.ClaimType, AmlScreening.Application.Security.AppPermissions.AmlRecordsView))
            {
                <a class="outline-button text-decoration-none" asp-controller="AmlRecords" asp-action="Index">View All</a>
            }
        </div>
        <div class="table-responsive">
            <table class="activity-table">
                <thead>
                    <tr><th>Reference No</th><th>Name</th><th>Type</th><th>Country</th><th>Source</th><th>Created On</th></tr>
                </thead>
                <tbody>
                    @if (Model.RecentRecords.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No AML records are available.</td></tr>
                    }
                    else
                    {
                        @foreach (var record in Model.RecentRecords)
                        {
                            <tr>
                                <td>@record.ReferenceNo</td>
                                <td>@record.FullName</td>
                                <td>@record.RecordType</td>
                                <td>@record.Country</td>
                                <td>@record.SourceName</td>
                                <td>@record.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <p class="table-caption">Showing @Model.RecentRecords.Count recent record@(Model.RecentRecords.Count == 1 ? "" : "s")</p>
    </article>
</section>

@section Scripts {
    <script>
        document.getElementById("currentDate").textContent = new Intl.DateTimeFormat("en-GB", {
            day: "2-digit",
            month: "short",
            year: "numeric",
            weekday: "long"
        }).format(new Date());
    </script>
}
