@model IReadOnlyList<AmlScreening.Domain.Entities.Compliance.ComplianceAlert>
@{ ViewData["Title"] = "Compliance Alerts"; }
@section Styles { <link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" /> }
<section class="workflow-heading"><div><h1>Compliance Alerts</h1><p>Review screening, rule and risk alerts generated by AML decisions.</p></div></section>
<partial name="_WorkflowMessages" />
<section class="workflow-panel"><div class="workflow-panel-title"><h2>Alert Queue</h2><span>@Model.Count alerts</span></div><div class="table-responsive"><table class="workflow-table"><thead><tr><th>Alert</th><th>Severity</th><th>Reason</th><th>Status</th><th>Created</th><th>Investigation Action</th></tr></thead><tbody>
@if (Model.Count == 0) { <tr><td colspan="6" class="workflow-empty">No alerts have been generated.</td></tr> }
@foreach (var alert in Model) { <tr><td><strong>@alert.AlertReference</strong><small>Transaction #@alert.TransactionId</small></td><td><span class="risk-pill @alert.Severity.ToLowerInvariant()">@alert.Severity</span></td><td class="reason-cell">@alert.Reason</td><td>@alert.Status</td><td>@alert.CreatedDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@if (User.HasClaim(AppPermissions.ClaimType, AppPermissions.Alerts.Manage)) { <form asp-action="Update" method="post" class="inline-update">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@alert.Id" /><select name="Status"><option>INVESTIGATING</option><option>ESCALATED</option><option>RESOLVED</option><option>CLOSED</option></select><input name="Resolution" value="@alert.Resolution" placeholder="Resolution note" /><button type="submit">Save</button></form> }</td></tr> }
</tbody></table></div></section>
