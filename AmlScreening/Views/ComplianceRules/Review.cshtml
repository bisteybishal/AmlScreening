@model AmlScreening.Portal.ViewModels.ComplianceRuleReviewViewModel

@{
    ViewData["Title"] =
        "Review Compliance Rule";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/workflow.css"
          asp-append-version="true" />
}


<section class="workflow-heading">

    <div>

        <h1>
            Review Compliance Rule
        </h1>

        <p>
            Compare the currently active version
            with the pending version.
        </p>

    </div>

</section>


@if (!string.IsNullOrWhiteSpace(
        Model.ApprovalMessage))
{
    <div class="risk-review-notice">

        <i class="bi bi-info-circle"></i>

        @Model.ApprovalMessage

    </div>
}


<div class="row g-3">


    <div class="col-lg-6">

        <section class="workflow-panel">

            <h3>
                Current Approved
            </h3>


            @if (Model.ActiveRule == null)
            {
                <p class="text-muted">
                    No previous approved version.
                    This is the first version.
                </p>
            }
            else
            {
                <table class="table">

                    <tr>
                        <th>Version</th>
                        <td>
                            v@Model.ActiveRule.RuleVersion
                        </td>
                    </tr>

                    <tr>
                        <th>Name</th>
                        <td>
                            @Model.ActiveRule.RuleName
                        </td>
                    </tr>

                    <tr>
                        <th>Threshold</th>
                        <td>
                            @Model.ActiveRule.ThresholdAmount
                        </td>
                    </tr>

                    <tr>
                        <th>Currency</th>
                        <td>
                            @Model.ActiveRule.Currency
                        </td>
                    </tr>

                    <tr>
                        <th>Risk Score</th>
                        <td>
                            @Model.ActiveRule.RiskScore
                        </td>
                    </tr>

                    <tr>
                        <th>Action</th>
                        <td>
                            @Model.ActiveRule.Action
                        </td>
                    </tr>

                </table>
            }

        </section>

    </div>


    <div class="col-lg-6">

        <section class="workflow-panel">

            <h3>
                Pending Change
            </h3>


            <table class="table">

                <tr>
                    <th>Version</th>
                    <td>
                        v@Model.PendingRule.RuleVersion
                    </td>
                </tr>

                <tr>
                    <th>Name</th>
                    <td>
                        @Model.PendingRule.RuleName
                    </td>
                </tr>

                <tr>
                    <th>Threshold</th>
                    <td>
                        @Model.PendingRule.ThresholdAmount
                    </td>
                </tr>

                <tr>
                    <th>Currency</th>
                    <td>
                        @Model.PendingRule.Currency
                    </td>
                </tr>

                <tr>
                    <th>Risk Score</th>
                    <td>
                        @Model.PendingRule.RiskScore
                    </td>
                </tr>

                <tr>
                    <th>Action</th>
                    <td>
                        @Model.PendingRule.Action
                    </td>
                </tr>

                <tr>
                    <th>Maker</th>
                    <td>
                        @Model.PendingRule.CreatedBy
                    </td>
                </tr>

            </table>

        </section>

    </div>

</div>


<div class="mt-3 d-flex gap-2">

    <a asp-action="Index"
       class="btn btn-light">

        Back

    </a>


    @if (Model.CanApprove)
    {
        <form asp-action="Approve"
              method="post">

            @Html.AntiForgeryToken()


            <input type="hidden"
                   name="id"
                   value="@Model.PendingRule.Id" />


            <input type="hidden"
                   name="rowVersion"
                   value="@Convert.ToBase64String(Model.PendingRule.RowVersion)" />


            <button type="submit"
                    class="workflow-primary">

                <i class="bi bi-check2"></i>

                Approve Rule

            </button>

        </form>
    }

</div>