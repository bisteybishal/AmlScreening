@model AmlScreening.Portal.ViewModels.ComplianceRuleViewModel

@{
    ViewData["Title"] =
        "Edit Compliance Rule";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/workflow.css"
          asp-append-version="true" />
}


<section class="workflow-heading">

    <div>

        <h1>
            Edit Compliance Rule
        </h1>

        <p>
            @if (Model.ApprovalStatus == "APPROVED")
            {
                <text>
                    Editing this approved rule creates
                    a new Pending version.
                </text>
            }
            else
            {
                <text>
                    You are editing your Pending version.
                </text>
            }
        </p>

    </div>

</section>


<section class="workflow-panel">

    <form asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()


        <input asp-for="Id"
               type="hidden" />

        <input asp-for="RowVersion"
               type="hidden" />

        <input asp-for="RuleCode"
               type="hidden" />


        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>


        <div class="mb-3">

            <strong>
                @Model.RuleCode
            </strong>

            <span>
                v@Model.RuleVersion
                · @Model.ApprovalStatus
            </span>

        </div>


        <div class="row g-3">


            <div class="col-md-6">

                <label asp-for="RuleName"
                       class="form-label">
                    Rule Name
                </label>

                <input asp-for="RuleName"
                       class="form-control" />

            </div>


            <div class="col-md-6">

                <label asp-for="RuleType"
                       class="form-label">
                    Rule Type
                </label>

                <input asp-for="RuleType"
                       class="form-control" />

            </div>


            <div class="col-md-6">

                <label asp-for="ThresholdAmount"
                       class="form-label">
                    Threshold Amount
                </label>

                <input asp-for="ThresholdAmount"
                       class="form-control" />

            </div>


            <div class="col-md-6">

                <label asp-for="Currency"
                       class="form-label">
                    Currency
                </label>

                <input asp-for="Currency"
                       class="form-control" />

            </div>


            <div class="col-md-6">

                <label asp-for="LookbackMinutes"
                       class="form-label">
                    Lookback Minutes
                </label>

                <input asp-for="LookbackMinutes"
                       class="form-control" />

            </div>


            <div class="col-md-6">

                <label asp-for="TransactionCount"
                       class="form-label">
                    Transaction Count
                </label>

                <input asp-for="TransactionCount"
                       class="form-control" />

            </div>


            <div class="col-md-4">

                <label asp-for="RiskScore"
                       class="form-label">
                    Risk Score
                </label>

                <input asp-for="RiskScore"
                       class="form-control"
                       min="0"
                       max="100" />

            </div>


            <div class="col-md-4">

                <label asp-for="Action"
                       class="form-label">
                    Action
                </label>

                <select asp-for="Action"
                        class="form-select">

                    <option value="ALLOW">
                        Allow
                    </option>

                    <option value="REVIEW">
                        Review
                    </option>

                    <option value="BLOCK">
                        Block
                    </option>

                </select>

            </div>


            <div class="col-md-4">

                <label asp-for="Priority"
                       class="form-label">
                    Priority
                </label>

                <input asp-for="Priority"
                       class="form-control"
                       min="1" />

            </div>

        </div>


        <div class="mt-4 d-flex gap-2">

            <a asp-action="Index"
               class="btn btn-light">

                Cancel

            </a>


            <button type="submit"
                    class="workflow-primary">

                @(
                    Model.ApprovalStatus ==
                    "APPROVED"
                        ? "Create Pending Version"
                        : "Update Pending Rule"
                )

            </button>

        </div>

    </form>

</section>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}