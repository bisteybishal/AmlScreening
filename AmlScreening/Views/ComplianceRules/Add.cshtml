@model AmlScreening.Portal.ViewModels.ComplianceRuleViewModel

@{
    ViewData["Title"] =
        "Add Compliance Rule";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/workflow.css"
          asp-append-version="true" />
}


<section class="workflow-heading">

    <div>

        <h1>
            Add Compliance Rule
        </h1>

        <p>
            The new rule will be saved as Pending
            and requires approval by another
            authorized user from the same client.
        </p>

    </div>

</section>


<section class="workflow-panel">

    <form asp-action="Add"
          method="post">

        @Html.AntiForgeryToken()


        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>


        <div class="row g-3">


            <div class="col-md-6">

                <label asp-for="RuleCode"
                       class="form-label">
                    Rule Code
                </label>

                <input asp-for="RuleCode"
                       class="form-control" />

                <span asp-validation-for="RuleCode"
                      class="text-danger">
                </span>

            </div>


            <div class="col-md-6">

                <label asp-for="RuleName"
                       class="form-label">
                    Rule Name
                </label>

                <input asp-for="RuleName"
                       class="form-control" />

            </div>


            <div class="col-md-6">

                <label asp-for="RuleType"
                       class="form-label">
                    Rule Type
                </label>

                <input asp-for="RuleType"
                       class="form-control" />

            </div>


            <div class="col-md-6">

                <label asp-for="ThresholdAmount"
                       class="form-label">
                    Threshold Amount
                </label>

                <input asp-for="ThresholdAmount"
                       class="form-control" />

            </div>


            <div class="col-md-4">

                <label asp-for="Currency"
                       class="form-label">
                    Currency
                </label>

                <input asp-for="Currency"
                       class="form-control" />

            </div>


            <div class="col-md-4">

                <label asp-for="LookbackMinutes"
                       class="form-label">
                    Lookback Minutes
                </label>

                <input asp-for="LookbackMinutes"
                       class="form-control" />

            </div>


            <div class="col-md-4">

                <label asp-for="TransactionCount"
                       class="form-label">
                    Transaction Count
                </label>

                <input asp-for="TransactionCount"
                       class="form-control" />

            </div>


            <div class="col-md-4">

                <label asp-for="RiskScore"
                       class="form-label">
                    Risk Score
                </label>

                <input asp-for="RiskScore"
                       class="form-control"
                       min="0"
                       max="100" />

            </div>


            <div class="col-md-4">

                <label asp-for="Action"
                       class="form-label">
                    Action
                </label>

                <select asp-for="Action"
                        class="form-select">

                    <option value="ALLOW">
                        Allow
                    </option>

                    <option value="REVIEW">
                        Review
                    </option>

                    <option value="BLOCK">
                        Block
                    </option>

                </select>

            </div>


            <div class="col-md-4">

                <label asp-for="Priority"
                       class="form-label">
                    Priority
                </label>

                <input asp-for="Priority"
                       class="form-control"
                       min="1" />

            </div>

        </div>


        <div class="mt-4 d-flex gap-2">

            <a asp-action="Index"
               class="btn btn-light">

                Cancel

            </a>


            <button type="submit"
                    class="workflow-primary">

                Save Pending Rule

            </button>

        </div>

    </form>

</section>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}