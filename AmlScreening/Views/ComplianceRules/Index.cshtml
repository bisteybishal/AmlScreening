@model IReadOnlyList<AmlScreening.Portal.ViewModels.ComplianceRuleViewModel>

@using AmlScreening.Application.Security

@{
    ViewData["Title"] = "Compliance Rules";

    var canManage =
        User.HasClaim(
            AppPermissions.ClaimType,
            AppPermissions.Compliance.Manage);

    var canApprove =
        User.HasClaim(
            AppPermissions.ClaimType,
            AppPermissions.Compliance.Approve);
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/workflow.css"
          asp-append-version="true" />
}

<partial name="_WorkflowMessages" />


<section class="workflow-heading">

    <div>

        <h1>
            Compliance Rules
        </h1>

        <p>
            Manage partner compliance rules using
            maker-checker approval.
        </p>

    </div>


    @if (canManage)
    {
        <a class="workflow-primary"
           asp-action="Add">

            <i class="bi bi-plus-lg"></i>

            Add Rule

        </a>
    }

</section>


<section class="workflow-panel">

    <div class="table-responsive">

        <table class="workflow-table">

            <thead>

                <tr>

                    <th>
                        S.N.
                    </th>

                    <th>
                        Rule
                    </th>

                    <th>
                        Type
                    </th>

                    <th>
                        Version
                    </th>

                    <th>
                        Score
                    </th>

                    <th>
                        Action
                    </th>

                    <th>
                        Status
                    </th>

                    <th>
                        Active
                    </th>

                    <th>
                        Actions
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model == null ||
                     Model.Count == 0)
                {
                    <tr>

                        <td colspan="9"
                            class="workflow-empty">

                            No compliance rules found.

                        </td>

                    </tr>
                }
                else
                {
                    @for (var i = 0;
                          i < Model.Count;
                          i++)
                    {
                        var rule =
                            Model[i];

                        <tr>

                            <td>
                                @(i + 1)
                            </td>


                            <td>

                                <strong>
                                    @rule.RuleCode
                                </strong>

                                <div>
                                    @rule.RuleName
                                </div>

                            </td>


                            <td>
                                @rule.RuleType
                            </td>


                            <td>
                                v@rule.RuleVersion
                            </td>


                            <td>
                                @rule.RiskScore
                            </td>


                            <td>
                                @rule.Action
                            </td>


                            <td>

                                @if (string.Equals(
                                    rule.ApprovalStatus,
                                    "APPROVED",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="risk-status approved">
                                        Approved
                                    </span>
                                }
                                else if (string.Equals(
                                    rule.ApprovalStatus,
                                    "PENDING",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="risk-status pending">
                                        Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="risk-status">
                                        @rule.ApprovalStatus
                                    </span>
                                }

                            </td>


                            <td>

                                @if (rule.IsActive)
                                {
                                    <span class="risk-status approved">
                                        Yes
                                    </span>
                                }
                                else
                                {
                                    <span class="risk-status pending">
                                        No
                                    </span>
                                }

                            </td>


                            <td>

                                <div class="workflow-actions">


                                    @* =================================================
                                       EDIT PENDING
                                       Only original maker can edit.
                                       Controller already sets CanEdit.
                                       ================================================= *@

                                    @if (rule.CanEdit)
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@rule.Id">

                                            Edit Pending

                                        </a>
                                    }


                                    @* =================================================
                                       REVIEW / APPROVE
                                       Only another authorized checker.
                                       Controller sets CanApprove.
                                       ================================================= *@

                                    @if (rule.CanApprove &&
                                         canApprove)
                                    {
                                        <a asp-action="Review"
                                           asp-route-id="@rule.Id">

                                            Review

                                        </a>
                                    }


                                    @* =================================================
                                       CREATE NEW VERSION
                                       An approved rule can be edited by a user
                                       having Compliance.Manage.
                                       The current approved version remains active
                                       until the new pending version is approved.
                                       ================================================= *@

                                    @if (
                                        canManage
                                        &&
                                        string.Equals(
                                            rule.ApprovalStatus,
                                            "APPROVED",
                                            StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@rule.Id">

                                            New Version

                                        </a>
                                    }


                                    @* =================================================
                                       DELETE PENDING
                                       RowVersion MUST be posted.
                                       ================================================= *@

                                    @if (rule.CanDelete)
                                    {
                                        <form asp-action="Delete"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()


                                            <input type="hidden"
                                                   name="id"
                                                   value="@rule.Id" />


                                            @if (rule.RowVersion is
                                                { Length: > 0 })
                                            {
                                                <input type="hidden"
                                                       name="rowVersion"
                                                       value="@Convert.ToBase64String(
                                                                                                                  rule.RowVersion)" />
                                            }


                                            <button type="submit"
                                                    class="btn btn-link p-0"
                                                    onclick="return confirm(
                                                'Are you sure you want to delete this pending compliance rule?');">

                                                Delete Pending

                                            </button>

                                        </form>
                                    }

                                </div>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</section>