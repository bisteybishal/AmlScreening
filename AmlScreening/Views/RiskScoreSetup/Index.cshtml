@model AmlScreening.Portal.ViewModels.RiskScoringPageViewModel
@{
    ViewData["Title"] = "Risk Score Setup";
    var nepal = TimeZoneInfo.FindSystemTimeZoneById("Nepal Standard Time");
    string LocalTime(DateTime? value) => value.HasValue
        ? TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(value.Value, DateTimeKind.Utc), nepal).ToString("dd MMM yyyy, HH:mm")
        : "—";
    string Percent(decimal value) => value.ToString("0.##") + "%";
    var active = Model.ActiveModel;
    var pending = Model.PendingModel;
}
@section Styles {
    <link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/riskscore.css" asp-append-version="true" />
   
}
<div class="rs-page">
    <partial name="_WorkflowMessages" />
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="rs-notice" role="alert">@Model.ErrorMessage</div>
    }
    <header class="rs-intro">
        <h1>Risk Score Setup</h1>
        <p class="rs-muted">Set how risk is calculated and how the final score determines a decision.</p>
    </header>

    <section class="rs-card" aria-labelledby="model-heading">
        <header class="rs-header">
            <div><h2 id="model-heading">Risk model</h2><p class="rs-muted">Customer, transaction and screening weights must total 100%.</p></div>
            @if (Model.CanEditModel)
            {
                <a class="rs-button" asp-controller="RiskScoreSetup" asp-action="EditModel">
                    @(Model.HasModelDraft ? "Edit pending model" : active == null ? "Create model" : "Create new version")
                </a>
            }
        </header>
        <div class="rs-body">
            @if (active == null)
            {
                <div class="rs-notice"><strong>No approved model yet</strong><p>@(pending != null ? "A model is awaiting approval. Scoring cannot use it until it is approved." : "Create a model and have a different authorized reviewer approve it before calculating risk.")</p></div>
            }
            else
            {
                <div class="rs-status-line">
                    <span class="rs-badge rs-approved">Approved</span>
                    <strong>@active.ModelCode · Version @(active.ModelVersion)</strong>
                    <time>Effective @LocalTime(active.EffectiveFrom) (Nepal)</time>
                </div>
                <div class="rs-weights">
                    <div class="rs-weight"><span>Customer risk</span><strong>@Percent(active.CustomerWeightPercent)</strong></div>
                    <div class="rs-weight"><span>Transaction risk</span><strong>@Percent(active.TransactionWeightPercent)</strong></div>
                    <div class="rs-weight"><span>Screening risk</span><strong>@Percent(active.ScreeningWeightPercent)</strong></div>
                    <div class="rs-weight rs-total"><span>Total weight</span><strong>@Percent(active.CustomerWeightPercent + active.TransactionWeightPercent + active.ScreeningWeightPercent)</strong></div>
                </div>
                <p class="rs-formula">Final score = (customer score × customer weight) + (transaction score × transaction weight) + (screening score × screening weight).</p>
            }
            @if (pending != null)
            {
                <section class="rs-draft" aria-labelledby="pending-model-heading">
                    <div class="rs-draft-head">
                        <div class="rs-draft-title"><span class="rs-badge rs-pending">Pending approval</span><h3 id="pending-model-heading">@pending.ModelCode · Version @(pending.ModelVersion)</h3></div>
                        <a class="rs-button rs-secondary" asp-controller="RiskScoreSetup" asp-action="ReviewModel">Review model</a>
                    </div>
                    <div class="rs-weights">
                        <div class="rs-weight"><span>Customer risk</span><strong>@Percent(pending.CustomerWeightPercent)</strong></div>
                        <div class="rs-weight"><span>Transaction risk</span><strong>@Percent(pending.TransactionWeightPercent)</strong></div>
                        <div class="rs-weight"><span>Screening risk</span><strong>@Percent(pending.ScreeningWeightPercent)</strong></div>
                        <div class="rs-weight"><span>Total weight</span><strong>@Percent(pending.CustomerWeightPercent + pending.TransactionWeightPercent + pending.ScreeningWeightPercent)</strong></div>
                    </div>
                    <p class="rs-note">A different authorized reviewer must approve this version. Existing approved settings remain in use until then.</p>
                </section>
            }
        </div>
    </section>

    <section class="rs-card" aria-labelledby="ranges-heading">
        <header class="rs-header">
            <div><h2 id="ranges-heading">Risk ranges</h2><p class="rs-muted">Map scores from 0 to 100 to a risk level and decision.</p></div>
            @if (Model.CanEditBands)
            {
                <a class="rs-button" asp-controller="RiskScoreSetup" asp-action="Edit">@(Model.HasBandDraft ? "Edit pending ranges" : Model.Bands.Count == 0 ? "Create ranges" : "Create new version")</a>
            }
        </header>
        <div class="rs-body">
            @if (Model.HasBandDraft)
            {
                <div class="rs-draft-head rs-notice">
                    <div><strong>Range changes are awaiting approval</strong><p>Pending ranges are not used for scoring until approved.</p></div>
                    <a class="rs-button rs-secondary" asp-controller="RiskScoreSetup" asp-action="Review">Review ranges</a>
                </div>
            }
            @if (Model.Bands.Count == 0)
            {
                <div class="rs-empty">
                    <h3>No risk ranges to display</h3>
                    <p>@(Model.HasBandDraft ? "Open Review ranges to inspect the pending configuration." : Model.CanEditBands ? "Choose Create ranges to define risk levels and decisions. Cover the full 0–100 scale without gaps or overlaps." : "An authorized setup manager must create the ranges, followed by approval from a different authorized reviewer.")</p>
                    <p>Risk scoring requires approved ranges as well as an approved model and factor rules.</p>
                </div>
            }
            else
            {
                <div class="rs-scroll" tabindex="0" role="region" aria-label="Risk ranges">
                    <table class="rs-table">
                        <thead><tr><th scope="col">Risk level</th><th scope="col">Score range</th><th scope="col">Decision</th><th scope="col">Status</th><th scope="col">Remarks</th></tr></thead>
                        <tbody>
                            @foreach (var band in Model.Bands.OrderBy(x => x.MinimumScore))
                            {
                                <tr>
                                    <td><strong>@band.RiskLevel</strong></td>
                                    <td class="rs-score">@band.MinimumScore – @(band.MaximumScore ?? 100)</td>
                                    <td>@band.Decision</td>
                                    <td><span class="rs-badge @(band.ApprovalStatus == "APPROVED" ? "rs-approved" : band.ApprovalStatus == "PENDING" ? "rs-pending" : "")">@band.ApprovalStatus</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(band.Remarks) ? "—" : band.Remarks)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <details class="rs-audit">
                    <summary>View range creation and update details</summary>
                    <div class="rs-scroll" tabindex="0" role="region" aria-label="Range audit details">
                        <table class="rs-table">
                            <thead><tr><th scope="col">Risk level</th><th scope="col">Created by</th><th scope="col">Created (Nepal)</th><th scope="col">Updated by</th><th scope="col">Updated (Nepal)</th></tr></thead>
                            <tbody>
                                @foreach (var band in Model.Bands.OrderBy(x => x.MinimumScore))
                                {
                                    <tr><td>@band.RiskLevel</td><td>@(band.CreatedBy ?? "—")</td><td>@LocalTime(band.CreatedDate)</td><td>@(band.UpdatedBy ?? "—")</td><td>@LocalTime(band.UpdatedDate)</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
        </div>
    </section>
</div>
