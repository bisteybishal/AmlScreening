@model AmlScreening.Portal.ViewModels.RiskScoringPageViewModel
@{
    ViewData["Title"] = "Risk Score Setup";
    var canManage = User.HasClaim(AppPermissions.ClaimType, AppPermissions.RiskScoringManage);
    var nepal = TimeZoneInfo.FindSystemTimeZoneById("Nepal Standard Time");
    string LocalTime(DateTime? value) => value.HasValue
        ? TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(value.Value, DateTimeKind.Utc), nepal).ToString("dd MMM yyyy HH:mm")
        : "—";
}
@section Styles {
    <link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/risk-scoring.css" asp-append-version="true" />
}
<partial name="_WorkflowMessages" />
<section class="workflow-heading">
    <div><h1>Risk Score Setup</h1>
        @* <p>Final risk ranges use the document's 0–100 scale.</p> *@
        </div>
    @if (canManage && Model.Bands.Count > 0)
    {
        <a class="workflow-primary" asp-controller="RiskScoreSetup" asp-action="Edit">Edit ranges</a>
    }
</section>
@if (Model.ActiveModel == null)
{
    @* <div class="risk-review-notice">Risk calculation is not configured. Please contact your administrator.</div> *@
}
else if (Model.ActiveModel.ApprovalStatus != "APPROVED")
{
    <div class="risk-review-notice">The risk model is waiting for approval.</div>
}
@if (Model.HasBandDraft)
{
    <div class="risk-review-notice">
        You have pending range changes. Current scoring stays unchanged until they are applied.
        @if (canManage)
        {
            <form asp-controller="RiskScoreSetup" asp-action="Apply" method="post" class="risk-inline-form"
                  onsubmit="return confirm('Apply all reviewed risk ranges?');">
                @Html.AntiForgeryToken()
                <button class="workflow-primary" type="submit">Apply reviewed changes</button>
            </form>
        }
    </div>
}
<section class="workflow-panel">
    <div class="table-responsive">
        <table class="workflow-table risk-simple-table">
            <thead>
                <tr><th rowspan="2">S.N.</th><th rowspan="2">Risk type</th><th colspan="3">Range</th><th rowspan="2">Created by</th><th rowspan="2">Created date (Nepal)</th><th rowspan="2">Updated by</th><th rowspan="2">Updated date (Nepal)</th></tr>
                <tr><th>From</th><th>To</th><th>Remarks</th></tr>
            </thead>
            <tbody>
            @if (Model.Bands.Count == 0)
            {
                <tr><td colspan="9" class="workflow-empty">No risk ranges configured. Ask your administrator to complete database setup.</td></tr>
            }
            @for (var i = 0; i < Model.Bands.Count; i++)
            {
                var band = Model.Bands[i];
                <tr>
                    <td>@(i + 1)</td><td>@band.RiskLevel</td><td>@band.MinimumScore</td><td>@(band.MaximumScore ?? 100)</td>
                    <td>@(band.Remarks ?? "—")</td><td>@(band.CreatedBy ?? "—")</td><td>@LocalTime(band.CreatedDate)</td>
                    <td>@(band.UpdatedBy ?? "—")</td><td>@LocalTime(band.UpdatedDate)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
