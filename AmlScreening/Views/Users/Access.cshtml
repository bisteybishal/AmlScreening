@model AmlScreening.Portal.ViewModels.UserAccessViewModel
@{
    ViewData["Title"] = "Manage User Access";
}

@section Styles { <link rel="stylesheet" href="~/css/users.css" asp-append-version="true" /> }

<section class="user-editor-heading"><a asp-action="Index"><i class="bi bi-arrow-left"></i> Back to Users</a><h1>Edit User Permissions</h1><p>Select exactly what <strong>@Model.FullName</strong> is allowed to access.</p></section>

<form asp-action="Access" method="post" class="user-access-form">
    @Html.AntiForgeryToken()
    <input asp-for="UserId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="users-validation"></div>
    <section class="access-user-summary"><span>@string.Join("", Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant()</span><div><h2>@Model.FullName</h2><p>@@@Model.Username · @Model.RoleName</p></div></section>
    <div class="access-help"><i class="bi bi-info-circle"></i><span>The role supplies the default access. Changing a checkbox stores only an override for <strong>@Model.FullName</strong>. The user must sign in again.</span></div>
    <section class="user-permission-groups">
        @foreach (var group in Model.Permissions.GroupBy(x => x.PermissionName.Split('.')[0]))
        {
            <article class="user-permission-group">
                <header>
                    <span><i class="bi @(group.Key == "AMLRecords" ? "bi-shield-check" : group.Key == "Users" ? "bi-people" : group.Key == "Settings" ? "bi-gear" : "bi-lock")"></i></span>
                    <div><h2>@(group.Key == "AMLRecords" ? "AML Records" : group.Key == "SearchScreening" ? "Search Screening" : group.Key)</h2><p>@group.Count() permission@(group.Count() == 1 ? "" : "s")</p></div>
                </header>
                <div class="user-permission-list">
                    @foreach (var permission in group)
                    {
                        var actionName = permission.PermissionName.Split('.').Last();
                        var label = group.Key switch
                        {
                            "SearchScreening" => "View Search Screening",
                            "Settings" => "View Settings",
                            _ => $"{actionName} {group.Key}"
                        };
                        <label class="user-permission-option">
                            <input type="checkbox" name="SelectedPermissionIds" value="@permission.PermissionId" checked="@permission.IsSelected" />
                            <span><i class="bi bi-check"></i></span>
                            <p>
                                <strong>@label</strong>
                                <small>@permission.Description</small>
                                <small class="permission-source @(permission.HasOverride ? "override" : "inherited")">
                                    @(permission.HasOverride ? "User override" : permission.IsRoleGranted ? "Inherited from role" : "Not granted by role")
                                </small>
                            </p>
                        </label>
                    }
                </div>
            </article>
        }
    </section>
    <div class="user-editor-actions"><a class="users-secondary-button" asp-action="Index">Cancel</a><button class="users-primary-button" type="submit"><i class="bi bi-check2"></i> Save Permissions</button></div>
</form>
