@model AmlScreening.Portal.ViewModels.UserAccessViewModel

@{
    ViewData["Title"] = "User access";
}

<h2>Access: @Model.Username</h2>
<p>@Model.PartnerName → @Model.BranchName</p>

<form asp-action="Access" method="post">
    @Html.AntiForgeryToken()

    <input asp-for="UserId" type="hidden" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <fieldset class="mb-3">
        <legend class="fs-6">Roles</legend>

        @foreach (var role in Model.Roles)
        {
            <div class="form-check">
                <input type="checkbox"
                       name="SelectedRoleIds"
                       value="@role.RoleId"
                       id="role_@role.RoleId"
                       checked="@Model.SelectedRoleIds.Contains(role.RoleId)"
                       class="form-check-input" />

                <label for="role_@role.RoleId" class="form-check-label">
                    @role.RoleName
                </label>
            </div>
        }
    </fieldset>

    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">
            Active account
        </label>
    </div>

    <p class="text-muted">
        Changing access ends this user's existing sessions.
    </p>

    <button type="submit" class="btn btn-primary">Save access</button>

    <a asp-action="BranchUsers"
       asp-route-partnerId="@Model.PartnerId"
       asp-route-branchId="@Model.BranchId"
       class="btn btn-outline-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}