@model AmlScreening.Portal.ViewModels.PartnerBranchesViewModel

@{
    ViewData["Title"] = "Partner branches";
}

<partial name="_WorkflowMessages" />

<h2>@Model.PartnerName — Branches</h2>

<p>
    Partner code: @Model.PartnerCode |
    Status: @(Model.IsActive ? "Active" : "Inactive")
</p>

<div class="mb-3 d-flex gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary">
        Back to partners
    </a>

    <a asp-action="EditPartner"
       asp-route-partnerId="@Model.PartnerId"
       class="btn btn-outline-primary">
        Edit partner
    </a>

    @if (Model.IsActive)
    {
        <a asp-action="CreateBranch"
           asp-route-partnerId="@Model.PartnerId"
           class="btn btn-primary">
            Add branch
        </a>
    }
</div>

@if (Model.Branches.Count == 0)
{
    <div class="alert alert-info">No branches found.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Branch</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Users</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var branch in Model.Branches)
            {
                <tr>
                    <td>@branch.BranchName</td>
                    <td>@branch.Email</td>
                    <td>@branch.PhoneNumber</td>
                    <td>@(branch.IsActive ? "Active" : "Inactive")</td>
                    <td>@branch.UserCount</td>
                    <td>
                        <a asp-action="EditBranchDetail"
                           asp-route-branchId="@branch.BranchId"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>

                        <a asp-action="BranchUsers"
                           asp-route-partnerId="@Model.PartnerId"
                           asp-route-branchId="@branch.BranchId"
                           class="btn btn-sm btn-outline-secondary">
                            View users
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}