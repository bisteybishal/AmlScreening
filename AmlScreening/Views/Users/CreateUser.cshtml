@model AmlScreening.Portal.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Create user";

    var partnerName = Model.Partners
        .FirstOrDefault(x => x.PartnerId == Model.PartnerId)?.PartnerName;

    var branchName = Model.Branches
        .FirstOrDefault(x => x.BranchId == Model.BranchId)?.BranchName;
}

<partial name="_WorkflowMessages" />

<h2>Create user</h2>
<p>@partnerName → @branchName</p>

<form asp-action="CreateUser" method="post">
    @Html.AntiForgeryToken()

    <input asp-for="PartnerId" type="hidden" />
    <input asp-for="BranchId" type="hidden" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Username" class="form-label"></label>
        <input asp-for="Username"
               class="form-control"
               autocomplete="off" />
    </div>

    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <textarea asp-for="Address" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password"
               class="form-control"
               autocomplete="new-password" />
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword"
               class="form-control"
               autocomplete="new-password" />
    </div>

    <fieldset class="mb-3">
        <legend class="fs-6">Roles</legend>

        @foreach (var role in Model.Roles)
        {
            <div class="form-check">
                <input type="checkbox"
                       name="SelectedRoleIds"
                       value="@role.RoleId"
                       id="role_@role.RoleId"
                       checked="@Model.SelectedRoleIds.Contains(role.RoleId)"
                       class="form-check-input" />

                <label for="role_@role.RoleId" class="form-check-label">
                    @role.RoleName
                </label>
            </div>
        }
    </fieldset>

    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">Active</label>
    </div>

    <button type="submit" class="btn btn-primary">Create user</button>

    <a asp-action="BranchUsers"
       asp-route-partnerId="@Model.PartnerId"
       asp-route-branchId="@Model.BranchId"
       class="btn btn-outline-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}