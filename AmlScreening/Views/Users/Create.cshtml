@model AmlScreening.Portal.ViewModels.CreateUserViewModel

@using AmlScreening.Application.Security

@{
    ViewData["Title"] = "Add User";

    ViewData["WorkspaceKey"] =
        "Users";

    ViewData["WorkspaceUrl"] =
        Url.Action(
            "Index",
            "Users");

    var canManagePartners =
        User.HasClaim(
            AppPermissions.ClaimType,
            AppPermissions.Partners.Manage);
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/users.css"
          asp-append-version="true" />

}


<!-- ========================================================= -->
<!-- HEADER -->
<!-- ========================================================= -->

<section class="user-editor-heading">

    <a asp-action="Index">

        <i class="bi bi-arrow-left"></i>

        Back to Users

    </a>


    <h1>
        Add User
    </h1>


    <p>
        Create a portal user, select the Partner and Branch,
        and assign one or more roles.
    </p>

</section>


<!-- ========================================================= -->
<!-- FORM CARD -->
<!-- ========================================================= -->

<section class="user-editor-card">

    <div class="user-editor-title">

        <span>
            <i class="bi bi-person-plus"></i>
        </span>


        <div>

            <h2>
                Account Details
            </h2>


            <p>
                Partner and Branch determine data ownership.
                Roles determine what the user can access.
            </p>

        </div>

    </div>


    <form asp-action="Create"
          method="post"
          autocomplete="off">

        @Html.AntiForgeryToken()


        <div asp-validation-summary="ModelOnly"
             class="users-validation">
        </div>


        <div class="user-form-grid">


            <!-- ================================================= -->
            <!-- PARTNER -->
            <!-- ================================================= -->

            <div class="user-field">

                <label asp-for="PartnerId">
                    Partner
                </label>


                <select asp-for="PartnerId"
                        id="partnerSelect"
                        class="form-select">

                    <option value="0">
                        -- Select Partner --
                    </option>


                    @foreach (var partner in Model.Partners)
                    {
                        <option value="@partner.PartnerId">
                            @partner.PartnerName
                        </option>
                    }

                </select>


                <span asp-validation-for="PartnerId"
                      class="text-danger">
                </span>


                @if (canManagePartners)
                {
                    <small>

                        Partner not available?

                        <a asp-controller="Users"
                           asp-action="CreatePartner">

                            Create Partner

                        </a>

                    </small>
                }

            </div>


            <!-- ================================================= -->
            <!-- BRANCH -->
            <!-- ================================================= -->

            <div class="user-field">

                <label asp-for="BranchId">
                    Branch
                </label>


                <select asp-for="BranchId"
                        id="branchSelect"
                        class="form-select"
                        data-selected="@Model.BranchId">

                    <option value="0">
                        -- Select Branch --
                    </option>


                    @foreach (var branch in Model.Branches)
                    {
                        <option value="@branch.BranchId">
                            @branch.BranchName
                        </option>
                    }

                </select>


                <span asp-validation-for="BranchId"
                      class="text-danger">
                </span>


                @if (canManagePartners)
                {
                    <small>

                        Branch not available?

                        <a asp-controller="Users"
                           asp-action="CreateBranch"
                           asp-route-partnerId="@Model.PartnerId">

                            Create Branch

                        </a>

                    </small>
                }

            </div>


            <!-- ================================================= -->
            <!-- USERNAME -->
            <!-- ================================================= -->

            <div class="user-field">

                <label asp-for="Username">
                    Username
                </label>


                <input asp-for="Username"
                       autocomplete="username"
                       placeholder="Enter username" />


                <span asp-validation-for="Username"
                      class="text-danger">
                </span>

            </div>


            <!-- ================================================= -->
            <!-- EMAIL -->
            <!-- ================================================= -->

            <div class="user-field">

                <label asp-for="Email">
                    Email
                </label>


                <input asp-for="Email"
                       type="email"
                       autocomplete="email"
                       placeholder="user@example.com" />


                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>


            <!-- ================================================= -->
            <!-- PHONE -->
            <!-- ================================================= -->

            <div class="user-field">

                <label asp-for="PhoneNumber">
                    Phone Number
                </label>


                <input asp-for="PhoneNumber"
                       autocomplete="tel"
                       placeholder="Phone number" />


                <span asp-validation-for="PhoneNumber"
                      class="text-danger">
                </span>

            </div>


            <!-- ================================================= -->
            <!-- ADDRESS -->
            <!-- ================================================= -->

            <div class="user-field">

                <label asp-for="Address">
                    Address
                </label>


                <input asp-for="Address"
                       autocomplete="street-address"
                       placeholder="Address" />


                <span asp-validation-for="Address"
                      class="text-danger">
                </span>

            </div>


            <!-- ================================================= -->
            <!-- PASSWORD -->
            <!-- ================================================= -->

            <div class="user-field user-password">

                <label asp-for="Password">
                    Password
                </label>


                <div>

                    <input asp-for="Password"
                           type="password"
                           autocomplete="new-password"
                           placeholder="Minimum 8 characters" />


                    <button type="button"
                            class="password-toggle"
                            aria-label="Show password">

                        <i class="bi bi-eye"></i>

                    </button>

                </div>


                <span asp-validation-for="Password"
                      class="text-danger">
                </span>

            </div>


            <!-- ================================================= -->
            <!-- CONFIRM PASSWORD -->
            <!-- ================================================= -->

            <div class="user-field user-password">

                <label asp-for="ConfirmPassword">
                    Confirm Password
                </label>


                <div>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           autocomplete="new-password"
                           placeholder="Enter password again" />


                    <button type="button"
                            class="password-toggle"
                            aria-label="Show password">

                        <i class="bi bi-eye"></i>

                    </button>

                </div>


                <span asp-validation-for="ConfirmPassword"
                      class="text-danger">
                </span>

            </div>


            <!-- ================================================= -->
            <!-- ROLES -->
            <!-- ================================================= -->

            <div class="user-field">

                <label asp-for="SelectedRoleIds">
                    Roles
                </label>


                @if (Model.Roles == null ||
                     Model.Roles.Count == 0)
                {
                    <div class="users-validation">

                        No active roles are available.

                    </div>
                }
                else
                {
                    <div class="role-checkbox-list">

                        @foreach (var role in Model.Roles)
                        {
                            var selected =
                                Model.SelectedRoleIds != null
                                &&
                                Model.SelectedRoleIds.Contains(
                                    role.RoleId);


                            <label class="role-checkbox">

                                <input type="checkbox"
                                       name="SelectedRoleIds"
                                       value="@role.RoleId"
                                       checked="@selected" />


                                <span>
                                    @role.RoleName
                                </span>

                            </label>
                        }

                    </div>
                }


                <span asp-validation-for="SelectedRoleIds"
                      class="text-danger">
                </span>


                <small>
                    Permissions are inherited from the selected roles.
                    Roles and permissions can be changed later from
                    User Access.
                </small>

            </div>


            <!-- ================================================= -->
            <!-- STATUS -->
            <!-- ================================================= -->

            <div class="user-field">

                <label class="user-active-switch">

                    <input asp-for="IsActive"
                           type="checkbox" />


                    <span></span>


                    <strong>
                        Active User
                    </strong>


                    <small>
                        Active users can sign in to the portal.
                    </small>

                </label>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- ACTION BUTTONS -->
        <!-- ===================================================== -->

        <div class="user-editor-actions">

            <a class="users-secondary-button"
               asp-action="Index">

                Cancel

            </a>


            <button class="users-primary-button"
                    type="submit">

                <i class="bi bi-check2"></i>

                Create User

            </button>

        </div>

    </form>

</section>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                // ============================================
                // PARTNER -> BRANCH
                // ============================================

                const partnerSelect =
                    document.getElementById(
                        "partnerSelect");

                const branchSelect =
                    document.getElementById(
                        "branchSelect");

                const getBranchesUrl =
                    '@Url.Action("GetBranches", "Users")';


                async function loadBranches(
                    partnerId,
                    selectedBranchId = 0) {

                    branchSelect.innerHTML =
                        '<option value="0">-- Select Branch --</option>';


                    if (!partnerId ||
                        Number(partnerId) <= 0) {

                        branchSelect.disabled =
                            true;

                        return;
                    }


                    branchSelect.disabled =
                        true;


                    try {

                        const response =
                            await fetch(
                                `${getBranchesUrl}?partnerId=${encodeURIComponent(partnerId)}`,
                                {
                                    method:
                                        "GET",

                                    headers:
                                    {
                                        "X-Requested-With":
                                            "XMLHttpRequest"
                                    }
                                });


                        if (!response.ok) {

                            throw new Error(
                                "Unable to load branches.");

                        }


                        const branches =
                            await response.json();


                        branches.forEach(
                            branch => {

                                const option =
                                    document.createElement(
                                        "option");


                                option.value =
                                    branch.branchId;


                                option.textContent =
                                    branch.branchName;


                                if (
                                    Number(
                                        branch.branchId)
                                    ===
                                    Number(
                                        selectedBranchId)
                                ) {

                                    option.selected =
                                        true;

                                }


                                branchSelect.appendChild(
                                    option);

                            });

                    }
                    catch (error) {

                        console.error(
                            "Unable to load branches.",
                            error);

                    }
                    finally {

                        branchSelect.disabled =
                            false;

                    }
                }


                if (partnerSelect &&
                    branchSelect) {

                    partnerSelect
                        .addEventListener(
                            "change",
                            function () {

                                loadBranches(
                                    this.value,
                                    0);

                            });


                    /*
                     * If Partner is already selected but
                     * Branch list was not populated,
                     * load it from GetBranches.
                     */

                    if (
                        Number(
                            partnerSelect.value) > 0
                        &&
                        branchSelect.options.length <= 1
                    ) {

                        loadBranches(
                            partnerSelect.value,
                            branchSelect.dataset.selected);

                    }

                }


                // ============================================
                // PASSWORD SHOW/HIDE
                // ============================================

                document
                    .querySelectorAll(
                        ".user-password .password-toggle")
                    .forEach(
                        button => {

                            button.addEventListener(
                                "click",
                                function () {

                                    const input =
                                        this.parentElement
                                            ?.querySelector(
                                                "input");


                                    if (!input) {
                                        return;
                                    }


                                    const currentlyShowing =
                                        input.type ===
                                        "text";


                                    input.type =
                                        currentlyShowing
                                            ? "password"
                                            : "text";


                                    const icon =
                                        this.querySelector(
                                            "i");


                                    if (icon) {

                                        icon.className =
                                            currentlyShowing
                                                ? "bi bi-eye"
                                                : "bi bi-eye-slash";

                                    }


                                    this.setAttribute(
                                        "aria-label",
                                        currentlyShowing
                                            ? "Show password"
                                            : "Hide password");

                                });

                        });

            });

    </script>

}