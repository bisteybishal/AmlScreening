@model AmlScreening.Portal.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Add User";

    ViewData["WorkspaceKey"] =
        "Users";

    ViewData["WorkspaceUrl"] =
        Url.Action(
            "Index",
            "Users");
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/users.css"
          asp-append-version="true" />
}


<section class="user-editor-heading">

    <a asp-action="Index">
        <i class="bi bi-arrow-left"></i>
        Back to Users
    </a>

    <h1>Add User</h1>

    <p>
        Create a user, select their organization,
        and assign one or more roles.
    </p>

</section>


<section class="user-editor-card">

    <div class="user-editor-title">

        <span>
            <i class="bi bi-person-plus"></i>
        </span>

        <div>
            <h2>Account details</h2>
            <p>
                Client determines data ownership.
                Roles determine what the user can do.
            </p>
        </div>

    </div>


    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="users-validation">
        </div>


        <div class="user-form-grid">


            <!-- FULL NAME -->

            <div class="user-field">

                <label asp-for="FullName"></label>

                <input asp-for="FullName"
                       autocomplete="name" />

                <span asp-validation-for="FullName">
                </span>

            </div>


            <!-- CLIENT -->

            <div class="user-field">

                <label asp-for="ClientId">
                    Client / Organization
                </label>


                @if (Model.CanChooseClient)
                {
                    <select asp-for="ClientId"
                            class="form-select">

                        <option value="0">
                            -- Select Client / Company --
                        </option>

                        @foreach (var client
                            in Model.Clients)
                        {
                            <option value="@client.ClientId">
                                @client.ClientName
                            </option>
                        }

                    </select>
                    @if (User.HasClaim("Permission", "Clients.Manage"))
                    {
                        <a asp-controller="Clients" asp-action="Create">+ Create a new partner first</a>
                    }
                    <small>All users of this partner share its client data. Select multiple roles for portal and API access; do not create another client.</small>
                }
                else
                {
                    var currentClient =
                        Model.Clients
                            .FirstOrDefault(
                                x =>
                                    x.ClientId
                                    ==
                                    Model.ClientId);

                    <input asp-for="ClientId"
                           type="hidden" />

                    <input type="text"
                           value="@currentClient?.ClientName"
                           readonly />
                }


                <span asp-validation-for="ClientId">
                </span>

            </div>


            <!-- EMAIL -->

            <div class="user-field">

                <label asp-for="Email"></label>

                <input asp-for="Email"
                       autocomplete="email" />

                <span asp-validation-for="Email">
                </span>

            </div>


            <!-- ADDRESS -->

            <div class="user-field">

                <label asp-for="Address"></label>

                <input asp-for="Address"
                       autocomplete="street-address" />

                <span asp-validation-for="Address">
                </span>

            </div>


            <!-- PHONE -->

            <div class="user-field">

                <label asp-for="PhoneNumber"></label>

                <input asp-for="PhoneNumber"
                       autocomplete="tel" />

                <span asp-validation-for="PhoneNumber">
                </span>

            </div>


            <!-- USERNAME -->

            <div class="user-field">

                <label asp-for="Username"></label>

                <input asp-for="Username"
                       autocomplete="username" />

                <span asp-validation-for="Username">
                </span>

            </div>


            <!-- ROLES -->

            <div class="user-field">

                <label asp-for="SelectedRoleIds">
                    Roles
                </label>

                <div class="role-checkbox-list">

                    @foreach (var role
                        in Model.Roles)
                    {
                        <label class="role-checkbox">

                            <input type="checkbox"
                                   name="SelectedRoleIds"
                                   value="@role.RoleId"
                                   checked="@Model.SelectedRoleIds.Contains(role.RoleId)" />

                            <span>
                                @role.RoleName
                            </span>

                        </label>
                    }

                </div>

                <span asp-validation-for="SelectedRoleIds">
                </span>
                <div class="user-field api-credentials" id="apiCredentials" hidden>
                    <label><input asp-for="ApiEnabled" type="checkbox" /> Enable API access</label>
                    <label asp-for="ApiUsername"></label><input asp-for="ApiUsername" autocomplete="off" />
                    <label asp-for="ApiSecret"></label><input asp-for="ApiSecret" autocomplete="new-password" />
                    <small>Store this secret securely. It is saved as a one-way hash and cannot be displayed later.</small>
                    <span asp-validation-for="ApiUsername"></span><span asp-validation-for="ApiSecret"></span>
                </div>

                <small>
                    Permissions are inherited from the selected roles.
                    Advanced permission overrides can be configured after creation.
                </small>

            </div>


            <!-- PASSWORD -->

            <div class="user-field user-password">

                <label asp-for="Password"></label>

                <div>

                    <input asp-for="Password"
                           placeholder="Minimum 8 characters"
                           autocomplete="new-password" />

                    <button type="button"
                            aria-label="Show password">

                        <i class="bi bi-eye"></i>

                    </button>

                </div>

                <span asp-validation-for="Password">
                </span>

            </div>


            <!-- CONFIRM PASSWORD -->

            <div class="user-field user-password">

                <label asp-for="ConfirmPassword"></label>

                <div>

                    <input asp-for="ConfirmPassword"
                           placeholder="Enter the password again"
                           autocomplete="new-password" />

                    <button type="button"
                            aria-label="Show password">

                        <i class="bi bi-eye"></i>

                    </button>

                </div>

                <span asp-validation-for="ConfirmPassword">
                </span>

            </div>


            <!-- STATUS -->

            <label class="user-active-switch">

                <input asp-for="IsActive" />

                <span></span>

                <strong>
                    Active user
                </strong>

                <small>
                    User can sign in immediately.
                </small>

            </label>

        </div>


        <div class="user-editor-actions">

            <a class="users-secondary-button"
               asp-action="Index">
                Cancel
            </a>

            <button class="users-primary-button"
                    type="submit">

                <i class="bi bi-check2"></i>

                Create User

            </button>

        </div>

    </form>

</section>
<script>
(() => { const box=document.getElementById('apiCredentials'); const roles=[...document.querySelectorAll('input[name="SelectedRoleIds"]')];
  const update=()=>{ const api=roles.some(x=>x.checked && /apiuser|api user/i.test(x.closest('label')?.innerText||'')); if(box) box.hidden=!api; };
  roles.forEach(x=>x.addEventListener('change',update)); update(); })();
</script>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document
            .querySelectorAll(
                ".user-password button")
            .forEach(button => {

                button.addEventListener(
                    "click",
                    () => {

                        const input =
                            button
                                .parentElement
                                .querySelector("input");

                        const showing =
                            input.type === "text";

                        input.type =
                            showing
                                ? "password"
                                : "text";

                        button.innerHTML =
                            showing
                                ? '<i class="bi bi-eye"></i>'
                                : '<i class="bi bi-eye-slash"></i>';

                    });
            });

    </script>
}
