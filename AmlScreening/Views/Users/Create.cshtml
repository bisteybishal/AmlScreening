@model AmlScreening.Portal.ViewModels.CreateUserViewModel
@{
    ViewData["Title"] = "Add User";

    ViewData["WorkspaceKey"] = "Users";

    ViewData["WorkspaceUrl"] =
        Url.Action("Index", "Users");
}

@section Styles {
    <link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />
}

<section class="user-editor-heading">
    <a asp-action="Index"><i class="bi bi-arrow-left"></i> Back to Users</a>
    <h1>Add User</h1>
    <p>Create login access for a member of your AML screening team.</p>
</section>

<section class="user-editor-card">
    <div class="user-editor-title"><span><i class="bi bi-person-plus"></i></span><div><h2>Account details</h2><p>Enter the user information and assign an access role.</p></div></div>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="users-validation"></div>
        <div class="user-form-grid">

            
            <div class="user-field"><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName"></span></div><div class="user-field">
            <label asp-for="CompanyName"></label><input asp-for="CompanyName" autocomplete="organization" /> <span asp-validation-for="CompanyName"></span>
        </div>

        <div class="user-field"><label asp-for="Email"></label> <input asp-for="Email" autocomplete="email" /> <span asp-validation-for="Email"></span></div>

        <div class="user-field"> <label asp-for="Address"></label> <input asp-for="Address" autocomplete="street-address" /><span asp-validation-for="Address"></span> </div>

        <div class="user-field"><label asp-for="PhoneNumber"></label> <input asp-for="PhoneNumber" autocomplete="tel" /> <span asp-validation-for="PhoneNumber"></span> </div>
        <div class="user-field"><label asp-for="Username"></label><input asp-for="Username" autocomplete="username" /><span asp-validation-for="Username"></span></div>

        <div class="user-field">
            <label asp-for="SelectedRoleIds"> Roles </label><div class="role-checkbox-list">

            @foreach (var role in Model.Roles)
            {
                <label class="role-checkbox">

                    <input type="checkbox"
                           name="SelectedRoleIds"
                           value="@role.RoleId"
                           checked="@Model.SelectedRoleIds.Contains(role.RoleId)" />

                    <span>
                        @role.RoleName
                    </span>

                </label>
            }

        </div>

        <span asp-validation-for="SelectedRoleIds">
        </span>
    </div>

    <div class="user-field user-password"><label asp-for="Password"></label><div><input asp-for="Password" placeholder="Minimum 8 characters" autocomplete="new-password" /><button type="button" aria-label="Show password"><i class="bi bi-eye"></i></button></div><span asp-validation-for="Password"></span></div>
    <div class="user-field user-password"><label asp-for="ConfirmPassword"></label><div><input asp-for="ConfirmPassword" placeholder="Enter the password again" autocomplete="new-password" /><button type="button" aria-label="Show password"><i class="bi bi-eye"></i></button></div><span asp-validation-for="ConfirmPassword"></span></div>
    <label class="user-active-switch"><input asp-for="IsActive" /><span></span><strong>Active user</strong><small>The user can sign in immediately.</small></label>
</div>
<div class="user-editor-actions"><a class="users-secondary-button" asp-action="Index">Cancel</a><button class="users-primary-button" type="submit"><i class="bi bi-check2"></i> Create User</button></div>
</form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll(".user-password button").forEach(button => {
            button.addEventListener("click", () => {
                const input = button.parentElement.querySelector("input");
                const showing = input.type === "text";
                input.type = showing ? "password" : "text";
                button.innerHTML = showing ? '<i class="bi bi-eye"></i>' : '<i class="bi bi-eye-slash"></i>';
            });
        });
    </script>
}
