@model AmlScreening.Portal.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "Edit user";
}

<h2>Edit user: @Model.Username</h2>
<p>@Model.PartnerName → @Model.BranchName</p>

<form asp-action="EditUser" method="post">
    @Html.AntiForgeryToken()

    <input asp-for="UserId" type="hidden" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <textarea asp-for="Address" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" />
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">Active</label>
    </div>

    <button type="submit" class="btn btn-primary">Save user</button>

    <a asp-action="Access"
       asp-route-id="@Model.UserId"
       class="btn btn-outline-primary">
        Edit roles
    </a>

    <a asp-action="BranchUsers"
       asp-route-partnerId="@Model.PartnerId"
       asp-route-branchId="@Model.BranchId"
       class="btn btn-outline-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}