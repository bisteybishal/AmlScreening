@model AmlScreening.Portal.ViewModels.BranchUsersViewModel

@{
    ViewData["Title"] = "Branch users";
}

<partial name="_WorkflowMessages" />

<h2>@Model.PartnerName → @Model.BranchName → Users</h2>

<p>
    Total: @Model.TotalUsers |
    Active: @Model.ActiveUsers |
    Inactive: @Model.InactiveUsers
</p>

<div class="mb-3 d-flex gap-2">
    <a asp-action="PartnerBranchesDetail"
       asp-route-partnerId="@Model.PartnerId"
       class="btn btn-outline-secondary">
        Back to branches
    </a>

    <a asp-action="CreateUser"
       asp-route-partnerId="@Model.PartnerId"
       asp-route-branchId="@Model.BranchId"
       class="btn btn-primary">
        Add user
    </a>
</div>

@if (Model.Users.Count == 0)
{
    <div class="alert alert-info">No users found.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Roles</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.Username</td>
                    <td>@user.Email</td>
                    <td>@user.PhoneNumber</td>
                    <td>@user.RoleName</td>
                    <td>@(user.IsActive ? "Active" : "Inactive")</td>
                    <td>
                        <a asp-action="EditUser"
                           asp-route-id="@user.UserId"
                           class="btn btn-sm btn-outline-primary">
                            Edit user
                        </a>

                        <a asp-action="Access"
                           asp-route-id="@user.UserId"
                           class="btn btn-sm btn-outline-secondary">
                            Access
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="d-flex gap-2 align-items-center">
    @if (Model.Page > 1)
    {
        <a asp-action="BranchUsers"
           asp-route-partnerId="@Model.PartnerId"
           asp-route-branchId="@Model.BranchId"
           asp-route-page="@(Model.Page - 1)"
           class="btn btn-outline-secondary">
            Previous
        </a>
    }

    <span>Page @Model.Page of @Model.TotalPages</span>

    @if (Model.Page < Model.TotalPages)
    {
        <a asp-action="BranchUsers"
           asp-route-partnerId="@Model.PartnerId"
           asp-route-branchId="@Model.BranchId"
           asp-route-page="@(Model.Page + 1)"
           class="btn btn-outline-secondary">
            Next
        </a>
    }
</div>