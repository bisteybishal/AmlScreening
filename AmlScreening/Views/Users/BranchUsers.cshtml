@model AmlScreening.Portal.ViewModels.BranchUsersViewModel

@{
    ViewData["Title"] = "Branch Users";

    ViewData["WorkspaceKey"] =
        "Users";

    ViewData["WorkspaceUrl"] =
        Url.Action(
            "Index",
            "Users");
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/users.css"
          asp-append-version="true" />
}


<!-- ========================================================= -->
<!-- HEADER -->
<!-- ========================================================= -->

<section class="users-heading">

    <div>

        <a asp-action="PartnerBranches"
           asp-route-partnerId="@Model.PartnerId"
           class="text-decoration-none">

            <i class="bi bi-arrow-left"></i>

            Back to Branches

        </a>


        <h1 class="mt-2">
            @Model.BranchName
        </h1>


        <p>
            Users registered under
            <strong>@Model.PartnerName</strong>
            /
            <strong>@Model.BranchName</strong>.
        </p>

    </div>


    <a asp-action="Create"
       asp-route-partnerId="@Model.PartnerId"
       asp-route-branchId="@Model.BranchId"
       class="users-primary-button">

        <i class="bi bi-person-plus"></i>

        Add User

    </a>

</section>


<!-- ========================================================= -->
<!-- SUCCESS / ERROR -->
<!-- ========================================================= -->
@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">

        <i class="bi bi-check-circle me-2"></i>

        @success

    </div>
}


@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">

        <i class="bi bi-exclamation-triangle me-2"></i>

        @error

    </div>
}


<!-- ========================================================= -->
<!-- SUMMARY -->
<!-- ========================================================= -->

<div class="row g-3 mb-3">


    <!-- TOTAL USERS -->

    <div class="col-md-4">

        <div class="card h-100">

            <div class="card-body d-flex align-items-center gap-3">

                <div class="users-summary-icon teal">

                    <i class="bi bi-people"></i>

                </div>


                <div>

                    <small class="text-muted">
                        Total Users
                    </small>

                    <h3 class="mb-0">
                        @Model.TotalUsers
                    </h3>

                </div>

            </div>

        </div>

    </div>


    <!-- ACTIVE USERS -->

    <div class="col-md-4">

        <div class="card h-100">

            <div class="card-body d-flex align-items-center gap-3">

                <div class="users-summary-icon green">

                    <i class="bi bi-person-check"></i>

                </div>


                <div>

                    <small class="text-muted">
                        Active Users
                    </small>

                    <h3 class="mb-0">
                        @Model.ActiveUsers
                    </h3>

                </div>

            </div>

        </div>

    </div>


    <!-- INACTIVE USERS -->

    <div class="col-md-4">

        <div class="card h-100">

            <div class="card-body d-flex align-items-center gap-3">

                <div class="users-summary-icon gray">

                    <i class="bi bi-person-x"></i>

                </div>


                <div>

                    <small class="text-muted">
                        Inactive Users
                    </small>

                    <h3 class="mb-0">
                        @Model.InactiveUsers
                    </h3>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- USER LIST -->
<!-- ========================================================= -->

<section class="card">

    <div class="card-header bg-white">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <h5 class="mb-1">
                    User Details
                </h5>

                <small class="text-muted">

                    @Model.PartnerName
                    /
                    @Model.BranchName

                </small>

            </div>


            <span class="badge bg-light text-dark">

                @Model.TotalUsers
                user@(Model.TotalUsers == 1 ? "" : "s")

            </span>

        </div>

    </div>


    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">

                <tr>

                    <th>
                        SNo
                    </th>

                    <th>
                        User ID
                    </th>

                    <th>
                        Username
                    </th>

                    <th>
                        Role
                    </th>
                    <th>
                        Address
                    </th>
                    <th>
                        Phone Number
                    </th>
                    <th>
                        Status
                    </th>

                                    
                    <th>
                        Created
                    </th>

                    <th>
                        Last Login
                    </th>

                    @*  <th>
                        Action
                    </th> *@

                </tr>

            </thead>


            <tbody>

                @if (Model.Users == null ||
                     Model.Users.Count == 0)
                {
                    <tr>

                        <td colspan="8"
                            class="text-center py-5">

                            <i class="bi bi-people fs-3 text-muted"></i>


                            <div class="mt-2 fw-semibold">

                                No users found

                            </div>


                            <div class="text-muted mb-3">

                                No user has been created
                                for this branch yet.

                            </div>


                            <a asp-action="Create"
                               asp-route-partnerId="@Model.PartnerId"
                               asp-route-branchId="@Model.BranchId"
                               class="btn btn-sm btn-primary">

                                <i class="bi bi-person-plus"></i>

                                Add User

                            </a>

                        </td>

                    </tr>
                }
                else
                {
                    @for (
                        var i = 0;
                        i < Model.Users.Count;
                        i++)
                    {
                        var user =
                            Model.Users[i];


                        var serialNumber =
                            ((Model.Page - 1)
                                * Model.PageSize)
                            + i
                            + 1;


                        <tr>


                            <!-- SNO -->

                            <td>
                                @serialNumber
                            </td>


                            <!-- USER ID -->

                            <td>
                                @user.UserId
                            @*     <a asp-action="Access"
                                   asp-route-id="@user.UserId"
                                   class="fw-semibold text-decoration-none">

                                    @user.UserId

                                </a> *@

                            </td>


                            <!-- USERNAME -->

                            <td>

                                @* <a asp-action="Access"
                                   asp-route-id="@user.UserId"
                                   class="fw-semibold text-decoration-none"> *@

                                    <span class="d-inline-flex align-items-center gap-2">

                                        <span class="user-avatar-small">

                                         @*    @{
                                                var initial =
                                                    string.IsNullOrWhiteSpace(
                                                        user.Username)
                                                        ? "U"
                                                        : user.Username
                                                            .Substring(0, 1)
                                                            .ToUpperInvariant();
                                            }

                                            @initial *@

                                        </span>


                                        @user.Username

                                    </span>

                                @* </a> *@

                            </td>


                            <!-- ROLE -->

                            <td>

                                @if (!string.IsNullOrWhiteSpace(
                                    user.RoleName))
                                {
                                    <span class="badge bg-light text-dark">

                                        @user.RoleName

                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        -
                                    </span>
                                }

                            </td>

                            <td>

                                @user.Address

                            </td>

                            <td>

                                @user.PhoneNumber

                            </td>


                            <!-- STATUS -->

                            <td>

                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">

                                        <i class="bi bi-check-circle me-1"></i>

                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">

                                        <i class="bi bi-x-circle me-1"></i>

                                        Inactive

                                    </span>
                                }

                            </td>

                            <!-- CREATED -->

                            <td>
                                @user.CreatedDate.ToString("dd MMM yyyy")
                            </td>


                            <!-- LAST LOGIN -->

                            <td>

                                @if (user.LastLoginDate.HasValue)
                                {
                                    @user.LastLoginDate.Value.ToString("dd MMM yyyy, hh:mm tt")
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Never
                                    </span>
                                }

                            </td>


                           



                            <!-- ACTION -->
                            @*  <td>

                                <a asp-action="Access"
                                   asp-route-id="@user.UserId"
                                   class="btn btn-sm btn-outline-primary">

                                    <i class="bi bi-person-gear"></i>

                                    User Detail

                                </a>

                            </td> *@

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>


    <!-- ===================================================== -->
    <!-- PAGINATION -->
    <!-- ===================================================== -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white">

            <div class="d-flex
                justify-content-between
                align-items-center">


                <div class="text-muted small">

                    Page
                    @Model.Page
                    of
                    @Model.TotalPages

                </div>


                <div class="d-flex gap-2">


                    @if (Model.Page > 1)
                    {
                        <a asp-action="BranchUsers"
                           asp-route-partnerId="@Model.PartnerId"
                           asp-route-branchId="@Model.BranchId"
                           asp-route-page="@(Model.Page - 1)"
                           class="btn btn-sm btn-outline-secondary">

                            <i class="bi bi-chevron-left"></i>

                            Previous

                        </a>
                    }


                    @if (Model.Page < Model.TotalPages)
                    {
                        <a asp-action="BranchUsers"
                           asp-route-partnerId="@Model.PartnerId"
                           asp-route-branchId="@Model.BranchId"
                           asp-route-page="@(Model.Page + 1)"
                           class="btn btn-sm btn-outline-secondary">

                            Next

                            <i class="bi bi-chevron-right"></i>

                        </a>
                    }

                </div>

            </div>

        </div>
    }

</section>