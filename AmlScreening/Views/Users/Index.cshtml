@model AmlScreening.Portal.ViewModels.UsersPageViewModel

@{
    ViewData["Title"] = "User Management";
    ViewData["WorkspaceKey"] = "Users";
    ViewData["WorkspaceUrl"] =
        Url.Action("Index", "Users");
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/users.css"
          asp-append-version="true" />
}

<section class="users-heading">

    <div>
        <h1>User Management</h1>

        <p>
            Manage partners, branches and portal users.
        </p>
    </div>


    <a asp-action="CreatePartner"
       class="users-primary-button">

        <i class="bi bi-building-add"></i>

        Add Partner
    </a>

</section>


@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">
        @success
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}


<div class="row g-3 mb-3">

    <div class="col-md-3">

        <div class="card h-100">
            <div class="card-body">

                <small class="text-muted">
                    Total Partners
                </small>

                <h3 class="mb-0">
                    @Model.TotalPartners
                </h3>

            </div>
        </div>

    </div>


    <div class="col-md-3">

        <div class="card h-100">
            <div class="card-body">

                <small class="text-muted">
                    Active Partners
                </small>

                <h3 class="mb-0">
                    @Model.ActivePartners
                </h3>

            </div>
        </div>

    </div>


    <div class="col-md-3">

        <div class="card h-100">
            <div class="card-body">

                <small class="text-muted">
                    Inactive Partners
                </small>

                <h3 class="mb-0">
                    @Model.IActivePartners
                </h3>

            </div>
        </div>

    </div>


    <div class="col-md-3">

        <div class="card h-100">
            <div class="card-body">

                <small class="text-muted">
                    Total Users
                </small>

                <h3 class="mb-0">
                    @Model.TotalUsers
                </h3>

            </div>
        </div>

    </div>

</div>


<section class="card">

    <div class="card-header bg-white">

        <h5 class="mb-1">
            Partners
        </h5>

        <small class="text-muted">
            Click Partner ID or Partner Name to edit.
        </small>

    </div>


    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">

                <tr>
                    <th>SNo</th>
                    <th>ID</th>
                    <th>Partner Name</th>
                    <th>Address</th>
                    <th>Email</th>
                    <th>Phone Number</th>
                    <th>Country</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Action</th>
                </tr>

            </thead>

            <tbody>

                @if (Model.Partners.Count == 0)
                {
                    <tr>
                        <td colspan="9"
                            class="text-center py-5">

                            No partners found.

                        </td>
                    </tr>
                }
                else
                {
                    @for (var i = 0;
                          i < Model.Partners.Count;
                          i++)
                    {
                        var partner =
                            Model.Partners[i];

                        var sno =
                            ((Model.Page - 1)
                                * Model.PageSize)
                            + i
                            + 1;

                        <tr>

                            <td>
                                @sno
                            </td>


                            <td>

                                <a asp-action="EditPartner"
                                   asp-route-partnerId="@partner.PartnerId"
                                   class="fw-semibold text-decoration-none">

                                    @partner.PartnerId

                                </a>

                            </td>


                            <td>

                                <a asp-action="EditPartner"
                                   asp-route-partnerId="@partner.PartnerId"
                                   class="fw-semibold text-decoration-none">

                                    @partner.PartnerName

                                </a>

                            </td>


                            <td>
                                @partner.Address
                            </td>


                            <td>
                                @partner.Email
                            </td>


                            <td>
                                @partner.PhoneNumber
                            </td>

                            <td>
                                @partner.Country
                            </td>


                            <td>

                                @if (partner.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }

                            </td>


                            <td>
                                @partner.CreatedDate.ToString(
                                    "dd MMM yyyy")
                            </td>


                            <td>

                                <a asp-action="PartnerBranchesDetail"
                                   asp-route-partnerId="@partner.PartnerId"
                                   class="btn btn-sm btn-outline-primary">

                                    <i class="bi bi-diagram-3"></i>

                                    Branch

                                </a>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>


    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white">

            <div class="d-flex justify-content-between">

                <span>
                    Page @Model.Page of @Model.TotalPages
                </span>


                <div class="d-flex gap-2">

                    @if (Model.Page > 1)
                    {
                        <a asp-action="Index"
                           asp-route-page="@(Model.Page - 1)"
                           class="btn btn-sm btn-outline-secondary">

                            Previous

                        </a>
                    }


                    @if (Model.Page < Model.TotalPages)
                    {
                        <a asp-action="Index"
                           asp-route-page="@(Model.Page + 1)"
                           class="btn btn-sm btn-outline-secondary">

                            Next

                        </a>
                    }

                </div>

            </div>

        </div>
    }

</section>