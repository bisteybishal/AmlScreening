@model AmlScreening.Portal.ViewModels.SubscriptionPageViewModel
@{
    ViewData["Title"] = "Subscription Details";
}

@section Styles {
    <link rel="stylesheet" href="~/css/aml-records.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Subscription.css" asp-append-version="true" />
}

<section class="subscription-heading">
    <div><h1>Subscription Plans</h1><p>@Model.TotalRecords available plan@(Model.TotalRecords == 1 ? "" : "s")</p></div>
    @if (User.HasClaim(AppPermissions.ClaimType, AppPermissions.SubscriptionCreate))
    {
        <a class="records-primary-button" asp-action="Add"><i class="bi bi-plus-lg"></i> Add Subscription</a>
    }
</section>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="records-alert"><i class="bi bi-check-circle-fill"></i>@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@if (Model.Plans.Count == 0)
{
    <section class="subscription-empty">
        <i class="bi bi-credit-card"></i>
        <strong>No subscription plans found</strong>
        <p>No subscription information is currently available.</p>
    </section>
}
else
{
    <section class="subscription-grid">
        @foreach (var plan in Model.Plans)
        {
            <article class="subscription-card">
                <header class="subscription-card-header">
                    <div><h2>@plan.SourceName</h2><span class="source-code">@plan.SourceCode</span></div>
                    <span class="subscription-status @(plan.IsActive ? "active" : "inactive")">@(plan.IsActive ? "Active" : "Inactive")</span>
                </header>
                <div class="subscription-details">
                    <div class="subscription-detail"><i class="bi bi-calendar3"></i><div><small>Duration</small><strong>@plan.DurationMonths month@(plan.DurationMonths == 1 ? "" : "s")</strong></div></div>
                    <div class="subscription-detail"><i class="bi bi-cash-stack"></i><div><small>Subscription Rate</small><strong>@plan.Rate.ToString("N2")</strong></div></div>
                </div>
                <div class="subscription-id">Plan ID: @plan.PlanId</div>
                <div class="record-actions">
                    @if (User.HasClaim(AppPermissions.ClaimType, AppPermissions.SubscriptionEdit))
                    {
                        <a class="action-button edit" asp-action="Edit" asp-route-id="@plan.PlanId"><i class="bi bi-pencil-square"></i><span>Edit</span></a>
                    }
                    @if (User.HasClaim(AppPermissions.ClaimType, AppPermissions.SubscriptionDelete))
                    {
                        <form asp-action="Delete" method="post" onsubmit="return confirm('Soft delete plan @plan.PlanId?');">
                            @Html.AntiForgeryToken()
                            <input name="id" type="hidden" value="@plan.PlanId" />
                            <input name="rowVersion" type="hidden" value="@Convert.ToBase64String(plan.RowVersion)" />
                            <button type="submit" class="action-button delete"><i class="bi bi-trash3"></i><span>Delete</span></button>
                        </form>
                    }
                </div>
            </article>
        }
    </section>

    <nav class="records-pagination" aria-label="Subscription pagination">
        <span>Page @Model.Page of @Model.TotalPages</span>
        <div>
            <a class="page-button @(Model.HasPreviousPage ? "" : "disabled")" asp-action="Index" asp-route-page="@(Model.Page - 1)" aria-disabled="@(!Model.HasPreviousPage)"><i class="bi bi-chevron-left"></i> Previous</a>
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <a class="page-number @(pageNumber == Model.Page ? "active" : "")" asp-action="Index" asp-route-page="@pageNumber">@pageNumber</a>
            }
            <a class="page-button @(Model.HasNextPage ? "" : "disabled")" asp-action="Index" asp-route-page="@(Model.Page + 1)" aria-disabled="@(!Model.HasNextPage)">Next <i class="bi bi-chevron-right"></i></a>
        </div>
    </nav>
}
