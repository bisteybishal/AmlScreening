@using System.Security.Claims
@using AmlScreening.Application.Security
@using AmlScreening.Application.Models
@inject AmlScreening.Application.Interface.IMenuService MenuService
@{
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Admin User";

    var roles = User.FindAll(ClaimTypes.Role).Select(x => x.Value).Where(x => !string.IsNullOrWhiteSpace(x))
    .Distinct(StringComparer.OrdinalIgnoreCase)
    .ToArray();

    var role = roles.Length > 0 ? string.Join(", ", roles) : "User";

    var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "anonymous";
    var initials = string.Join("", fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var navigationItems = await MenuService.GetForCurrentUserAsync();
    // Support existing database menu rows until the manual menu script is applied.
    string? MenuController(NavigationMenuItem item) => item.ControllerName == "RiskScoring"
        ? (item.ActionName == "Setup" ? "RiskScoreSetup" : "RiskScores") : item.ControllerName;
    string? MenuAction(NavigationMenuItem item) => item.ControllerName == "RiskScoring" ? "Index" : item.ActionName;
    bool IsCurrent(NavigationMenuItem item) =>
        string.Equals(MenuController(item), currentController, StringComparison.OrdinalIgnoreCase);
    bool IsOpen(NavigationMenuItem item) => IsCurrent(item) || item.Children.Any(IsCurrent);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AML Screening</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="portal-shell">
        <aside id="sidebar" class="sidebar" aria-label="Main navigation">
            <a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-shield"><i class="bi bi-shield-check"></i></span>
                <span class="brand-copy"><strong>AML</strong><small>SCREENING</small></span>
            </a>
            <nav class="sidebar-nav">
                @foreach (var section in navigationItems.GroupBy(item => item.SectionName))
                {
                    @if (!section.Key.Equals("MAIN", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="nav-divider"></div>
                    }
                    <div class="nav-section-label">@(section.Key)</div>
                    @foreach (var item in section.OrderBy(item => item.SortOrder))
                    {
                        @if (item.Children.Count > 0)
                        {
                            var submenuId = $"menu-{item.MenuId}";
                            <button class="nav-link submenu-toggle @(IsOpen(item) ? "active" : "")"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@submenuId"
                                    aria-expanded="@(IsOpen(item) ? "true" : "false")"
                                    aria-controls="@submenuId">
                                <i class="bi @item.IconClass"></i>
                                <span>@item.DisplayName</span>
                                <i class="bi bi-chevron-down submenu-arrow"></i>
                            </button>
                            <div id="@submenuId" class="collapse @(IsOpen(item) ? "show" : "")">
                                @foreach (var child in item.Children.OrderBy(child => child.SortOrder))
                                {
                                    <a class="nav-link submenu-link @(IsCurrent(child) ? "active" : "")"
                                       asp-controller="@MenuController(child)"
                                       asp-action="@MenuAction(child)">
                                        <i class="bi @child.IconClass"></i>
                                        <span>@child.DisplayName</span>
                                    </a>
                                }
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(item.ControllerName))
                        {
                            <a class="nav-link @(IsCurrent(item) ? "active" : "")"
                               asp-controller="@MenuController(item)"
                               asp-action="@MenuAction(item)">
                                <i class="bi @item.IconClass"></i>
                                <span>@item.DisplayName</span>
                            </a>
                        }
                    }
                }
            </nav>
            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <span class="avatar">@initials</span>
                    <span class="sidebar-user-copy"><strong>@fullName</strong><small>@role</small></span>
                    <i class="bi bi-chevron-right ms-auto"></i>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button class="logout-button" type="submit"><i class="bi bi-box-arrow-right"></i><span>Logout</span></button>
                </form>
            </div>
        </aside>
        <div id="sidebarBackdrop" class="sidebar-backdrop"></div>
        <div class="portal-main">
            <header class="topbar">
                <div class="topbar-left">
                    <button id="sidebarToggle" class="sidebar-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false"><i class="bi bi-list"></i></button>
                    <strong class="page-name">@ViewData["Title"]</strong>
                </div>
                <div class="topbar-right">
                    <button class="notification-button" type="button" aria-label="Notifications"><i class="bi bi-bell"></i></button>
                    <div class="topbar-separator"></div>
                    <div class="profile-summary">
                        <span class="avatar">@initials</span>
                        <span class="profile-copy"><strong>@fullName</strong><small>@role</small></span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                </div>
            </header>
            <nav id="workspaceTabs"
                 class="workspace-tabs"
                 aria-label="Open pages"
                 data-dashboard-url="@Url.Action("Index", "Dashboard")"
                 data-current-url="@($"{Context.Request.Path}{Context.Request.QueryString}")"
                 data-current-title="@ViewData["Title"]"
                 data-user-key="@userId"
                 data-is-dashboard="@((currentController == "Dashboard").ToString().ToLowerInvariant())"
                 data-workspace-key="@(ViewData["WorkspaceKey"] ?? currentController)"
                 data-workspace-url="@(ViewData["WorkspaceUrl"] ?? $"{Context.Request.Path}{Context.Request.QueryString}")">

                <a class="workspace-tab dashboard-tab @(currentController == "Dashboard" ? "active" : "")"
                   asp-controller="Dashboard"
                   asp-action="Index">

                    <i class="bi bi-house-door"></i>

                    <span>
                        Dashboard
                    </span>

                </a>

                <div id="dynamicWorkspaceTabs"
                     class="dynamic-workspace-tabs">
                </div>

            </nav>
            <main class="main-content">@RenderBody()</main>
            <footer class="portal-footer"><span>&copy; @DateTime.UtcNow.Year AML Screening System. All rights reserved.</span><span>Version 1.0.0</span></footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
