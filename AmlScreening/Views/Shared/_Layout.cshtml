@using System.Security.Claims
@{
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Admin User";
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "Administrator";
    var initials = string.Join("", fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AML Screening</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="portal-shell">
        <aside id="sidebar" class="sidebar" aria-label="Main navigation">
            <a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-shield"><i class="bi bi-shield-check"></i></span>
                <span class="brand-copy"><strong>AML</strong><small>SCREENING</small></span>
            </a>
            <nav class="sidebar-nav">
                <div class="nav-section-label">MAIN</div>
                <a class="nav-link @(currentController == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-house-door-fill"></i><span>Dashboard</span></a>
                <a class="nav-link @(currentController == "AmlRecords" ? "active" : "")" asp-controller="AmlRecords" asp-action="Index"><i class="bi bi-shield-check"></i><span>AML Records</span></a>
                <a class="nav-link" href="#"><i class="bi bi-search"></i><span>Search Screening</span></a>
                <a class="nav-link" href="#"><i class="bi bi-list-check"></i><span>Watchlists</span></a>
                <div class="nav-divider"></div>
                <div class="nav-section-label">MANAGEMENT</div>
                <a class="nav-link" href="#"><i class="bi bi-people"></i><span>Users</span></a>
                <a class="nav-link" href="#"><i class="bi bi-lock"></i><span>Roles &amp; Permissions</span></a>
                <a class="nav-link" asp-controller="AmlRecords" asp-action="Index" asp-fragment="recordsReport"><i class="bi bi-bar-chart"></i><span>Reports</span></a>
                <a class="nav-link" href="#"><i class="bi bi-file-earmark-text"></i><span>Audit Logs</span></a>
                <a class="nav-link" href="#"><i class="bi bi-gear"></i><span>Settings</span></a>
            </nav>
            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <span class="avatar">@initials</span>
                    <span class="sidebar-user-copy"><strong>@fullName</strong><small>@role</small></span>
                    <i class="bi bi-chevron-right ms-auto"></i>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button class="logout-button" type="submit"><i class="bi bi-box-arrow-right"></i><span>Logout</span></button>
                </form>
            </div>
        </aside>
        <div id="sidebarBackdrop" class="sidebar-backdrop"></div>
        <div class="portal-main">
            <header class="topbar">
                <div class="topbar-left">
                    <button id="sidebarToggle" class="sidebar-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false"><i class="bi bi-list"></i></button>
                    <strong class="page-name">@ViewData["Title"]</strong>
                </div>
                <div class="topbar-right">
                    <button class="notification-button" type="button" aria-label="Notifications"><i class="bi bi-bell"></i><span>5</span></button>
                    <div class="topbar-separator"></div>
                    <div class="profile-summary">
                        <span class="avatar">@initials</span>
                        <span class="profile-copy"><strong>@fullName</strong><small>@role</small></span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                </div>
            </header>
            <main class="main-content">@RenderBody()</main>
            <footer class="portal-footer"><span>&copy; 2026 AML Screening System. All rights reserved.</span><span>Version 1.0.0</span></footer>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
