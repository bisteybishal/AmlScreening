@model AmlScreening.Application.Models.RiskApprovalReview
@{
    ViewData["Title"] = Model.Title;
    var controller = Model.Kind == "Rules" ? "RiskScores" : "RiskScoreSetup";
}
@section Styles {
    <link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/risk-scoring.css" asp-append-version="true" />
}
<section class="workflow-heading"><h1>@Model.Title</h1></section>
<div class="risk-review-notice">
    <strong>Pending · Maker: @(Model.MakerName ?? "Not verified")</strong>
    <p>@(Model.Kind == "Rules" ? "Review this score change only. Other approved scores stay unchanged." : "Review the adjoining ranges together. Approval replaces the active range set.") The maker cannot approve.</p>
</div>
<div class="risk-review-columns">
    @foreach (var panel in new[] { (Title: "Currently active", Rows: Model.ActiveRows), (Title: "Pending changes", Rows: Model.PendingRows) })
    {
        <section class="workflow-panel">
            <h2>@panel.Title</h2>
            <div class="table-responsive">
                <table class="workflow-table risk-simple-table">
                    <thead><tr><th>Value / risk type</th><th>Score / range</th><th>Explanation</th><th>Action</th></tr></thead>
                    <tbody>
                    @if (panel.Rows.Count == 0) { <tr><td colspan="4">No active entries.</td></tr> }
                    @foreach (var row in panel.Rows)
                    {
                        <tr class="@(row.Removed ? "risk-removed" : "")">
                            <td>@row.Value</td><td>@row.ScoreOrRange</td><td>@row.Remarks</td>
                            <td>@(row.Removed ? "Remove on approval" : (panel.Title == "Pending changes" ? "Save on approval" : "Current"))</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>
@if (Model.CanApprove)
{
    <form asp-controller="@controller" asp-action="Apply" method="post"
          onsubmit="return confirm('Approve the displayed change(s)?');">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ruleId" value="@Model.RuleId" />
        <input type="hidden" name="factorCode" value="@Model.FactorCode" />
        <input type="hidden" name="reviewToken" value="@Model.ReviewToken" />
        <button type="submit" class="workflow-primary">Approve changes</button>
    </form>
}
else { <p class="risk-review-notice">@Model.ApprovalMessage</p> }
<p><a asp-controller="@controller" asp-action="Index" asp-route-factorCode="@Model.FactorCode">Back to list</a></p>
