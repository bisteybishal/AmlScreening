@model AmlScreening.Portal.ViewModels.SubscriptionAddModel

<div asp-validation-summary="ModelOnly" class="records-validation-summary"></div>

<div class="record-form-grid">
    <div class="field">
        <label asp-for="SourceCode"></label>
        <input asp-for="SourceCode" placeholder="e.g. PEP, UN or EU" />
        <span asp-validation-for="SourceCode"></span>
    </div>
    <div class="field">
        <label asp-for="SourceName"></label>
        <input asp-for="SourceName" placeholder="e.g. UN Sanctions" />
        <span asp-validation-for="SourceName"></span>
    </div>
    <div class="field">
        <label asp-for="DurationMonths"></label>
        <input asp-for="DurationMonths" type="number" min="1" max="120" placeholder="e.g. 12" />
        <span asp-validation-for="DurationMonths"></span>
    </div>
    <div class="field">
        <label asp-for="Rate"></label>
        <input asp-for="Rate" type="number" min="0.01" step="0.01" placeholder="e.g. 25000.00" />
        <span asp-validation-for="Rate"></span>
    </div>
    <label class="active-switch full">
        <input asp-for="IsActive" />
        <span></span><strong>Active subscription</strong><small>Make this subscription plan available for use.</small>
    </label>
</div>
