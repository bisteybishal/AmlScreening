@model AmlScreening.Portal.ViewModels.CustomerInputModel

<input asp-for="Id" type="hidden" />
<input asp-for="RowVersion" type="hidden" />
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="workflow-form-grid">
    <div><label asp-for="CustomerReference"></label><input asp-for="CustomerReference" /><span asp-validation-for="CustomerReference"></span></div>
    <div><label asp-for="FullName"></label><input asp-for="FullName" /><span asp-validation-for="FullName"></span></div>
    <div><label asp-for="DateOfBirth"></label><input asp-for="DateOfBirth" type="date" /><span asp-validation-for="DateOfBirth"></span></div>
    <div><label asp-for="Country"></label><input asp-for="Country" /><span asp-validation-for="Country"></span></div>
    <div><label asp-for="Nationality"></label><input asp-for="Nationality" /><span asp-validation-for="Nationality"></span></div>
    <div><label asp-for="Occupation"></label><input asp-for="Occupation" /><span asp-validation-for="Occupation"></span></div>
    <div class="full"><label asp-for="SourceOfFunds"></label><input asp-for="SourceOfFunds" /><span asp-validation-for="SourceOfFunds"></span></div>
    <label class="workflow-check"><input asp-for="IsPep" /><span>PEP customer</span></label>
    <label class="workflow-check"><input asp-for="IsActive" /><span>Active customer</span></label>
</div>
