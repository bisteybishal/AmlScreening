@model AmlScreening.Portal.ViewModels.CustomerKycViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Customer Screening";

    var result = Model.Result;
    var hasErrors = !ViewData.ModelState.IsValid;
    var hasscreeingErrors = !string.IsNullOrWhiteSpace(Model.ScreeningMessage);

    var riskClass = result?.RiskLevel?.Trim().ToUpperInvariant() switch
    {
        "LOW" => "risk-low",
        "MEDIUM" => "risk-medium",
        "HIGH" => "risk-high",
        "CRITICAL" => "risk-critical",
        _ => ""
    };
}


        
        <link rel="stylesheet" href="~/css/customer-kyc.css" asp-append-version="true" / >


<div class="screening-page">

    <header class="screening-header">
        <span class="screening-eyebrow">Customer Screening</span>
       
    </header>

    <div class="screening-layout">

        <!-- CUSTOMER FORM -->
        <section class="screening-card">
            <div class="screening-card-heading">
                <span class="screening-icon" aria-hidden="true">
                    <i class="bi bi-person-vcard"></i>
                </span>
                <div>
                    <h2>Customer Details</h2>
                </div>
            </div>

            <form id="customerScreeningForm"
                  asp-controller="CustomerKyc"
                  asp-action="Screen"
                  method="post"
                  asp-antiforgery="true">

                <div asp-validation-summary="ModelOnly"
                     class="screening-errors"
                     role="alert"></div>

                <div class="screening-fields">

                    <div class="screening-field">
                        <label asp-for="FullName"
                               class="screening-label">
                            <span>
                                Full name
                                <span class="screening-required">*</span>
                            </span>
                        </label>
                        <input asp-for="FullName"
                               class="screening-input"
                               placeholder="Enter full name"
                               autocomplete="name"
                               required />
                        <span asp-validation-for="FullName"></span>
                    </div>

                    <div class="screening-field">
                        <label asp-for="DateOfBirth"
                               class="screening-label">
                            <span>Date of birth</span>
                            <span class="screening-optional">Optional</span>
                        </label>
                        <input asp-for="DateOfBirth"
                               type="date"
                               class="screening-input" />
                        <span asp-validation-for="DateOfBirth"></span>
                    </div>

                    <div class="screening-field">
                        <label asp-for="Country"
                               class="screening-label">
                            <span>
                                Country
                                <span class="screening-required">*</span>
                            </span>
                        </label>
                        <select asp-for="Country"
                                asp-items="Model.CountryOptions"
                                class="screening-input"
                                required>
                            <option value="">Select country</option>
                        </select>
                        <span asp-validation-for="Country"></span>
                    </div>

                    <div class="screening-field">
                        <label asp-for="Gender"
                               class="screening-label">
                            <span>
                                Gender
                                <span class="screening-required">*</span>
                            </span>
                        </label>
                        <select asp-for="Gender"
                                asp-items="Model.GenderOptions"
                                class="screening-input"
                                required>
                            <option value="">Select gender</option>
                        </select>
                        <span asp-validation-for="Gender"></span>
                    </div>

                    <div class="screening-field">
                        <label asp-for="ScreeningType"
                               class="screening-label">
                            <span>
                                Screening type
                                <span class="screening-required">*</span>
                            </span>
                        </label>
                        <select asp-for="ScreeningType"
                                asp-items="Model.ScreeningTypeOptions"
                                class="screening-input"
                                required>
                            <option value="">Select screening type</option>
                        </select>
                        <span asp-validation-for="ScreeningType"></span>
                    </div>

                    <div class="screening-field">
                        <label asp-for="Occupation"
                               class="screening-label">
                            <span>
                                Occupation
                                <span class="screening-required"></span>
                            </span>
                        </label>
                        <select asp-for="Occupation"
                                asp-items="Model.OccupationOptions"
                                class="screening-input"
                                >
                            <option value="">Select occupation</option>
                        </select>
                        <span asp-validation-for="Occupation"></span>
                    </div>

                    <div class="screening-field">
                        <label asp-for="SourceOfFunds"
                               class="screening-label">
                            <span>
                                Source of funds
                                <span class="screening-required"></span>
                            </span>
                        </label>
                        <select asp-for="SourceOfFunds"
                                asp-items="Model.SourceOfFundsOptions"
                                class="screening-input"
                                >
                            <option value="">Select source of funds</option>
                        </select>
                        <span asp-validation-for="SourceOfFunds"></span>
                    </div>

                </div>

                <div class="screening-actions">
                    <button id="screeningSubmit"
                            type="submit"
                            class="screening-submit">
                        <i class="bi bi-search screening-search-icon"
                           aria-hidden="true"></i>
                        <span class="screening-busy-icon"
                              aria-hidden="true"></span>
                        <span id="screeningButtonText">
                            Check PEP/Sanction
                        </span>
                    </button>

                    <a asp-controller="CustomerKyc"
                       asp-action="Index"
                       class="screening-clear">
                        Clear
                    </a>
                </div>

                @* <p class="screening-note">
                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                    <span>
                        Screening activity is recorded for audit  and usage tracking.
                    </span>
                </p> *@
            </form>
        </section>

        <!-- SCREENING RESULT -->
        <section class="screening-card"
                 id="screeningResult"
                 aria-labelledby="screeningResultTitle">

            <div class="screening-card-heading">
                <span class="screening-icon" aria-hidden="true">
                    <i class="bi bi-shield-check"></i>
                </span>
                <div>
                    <h2 id="screeningResultTitle">Screening Result</h2>
                    <p>
                        @(result == null
                            ? "Your result will appear here."
                            : Model.FullName)
                    </p>
                </div>
            </div>

            <div id="screeningStatus" role="status" aria-live="polite">
                @if (result == null)
                {
                    <div class="screening-empty">

                        <span class="screening-empty-icon"
                              aria-hidden="true">

                            @if (hasscreeingErrors)
                            {
                                <i class="bi bi-exclamation-circle"></i>
                            }
                            else if (hasErrors)
                            {
                                <i class="bi bi-exclamation-circle"></i>
                            }
                            else
                            {
                                <i class="bi bi-shield-check"></i>
                            }

                        </span>


                        @if (hasscreeingErrors)
                        {
                            <h3 id="screeningEmptyTitle">
                                No AML name match
                            </h3>

                            <p id="screeningEmptyMessage">
                                @Model.ScreeningMessage
                            </p>
                        }
                        else if (hasErrors)
                        {
                            <h3 id="screeningEmptyTitle">
                                Check not completed
                            </h3>

                            <p id="screeningEmptyMessage">
                                Complete the required customer details
                                and submit again.
                            </p>
                        }
                        else
                        {
                            <h3 id="screeningEmptyTitle">
                                Ready when you are
                            </h3>

                            <p id="screeningEmptyMessage">
                                Enter customer details and select
                                Check PEP/Sanction to start screening.
                            </p>
                        }

                    </div>
                }
            </div>

            @if (result != null)
            {
                <div class="screening-risk">
                    <div>
                        <p class="screening-risk-label">
                            Calculated risk score
                        </p>
                        <div class="screening-risk-score">
                            @result.RiskScore.ToString("0.##")
                        </div>
                        <p class="screening-risk-caption">
                            Based on the configured risk model
                        </p>
                    </div>

                    <span class="screening-badge @riskClass">
                        @result.RiskLevel
                    </span>
                </div>

                <h3 class="screening-section-title">
                    @(result.Matches.Count > 0
                        ? "Potential AML matches"
                        : "No AML match found")
                </h3>

                <p class="screening-description">
                    @if (result.Matches.Count > 0)
                    {
                        <text>
                            @result.Matches.Count potential
                            @(result.Matches.Count == 1 ? "match" : "matches")
                            found. Review the details below.
                        </text>
                    }
                    else
                    {
                        <text>
                            No AML record met the configured
                            match threshold for this screening.
                        </text>
                    }
                </p>

                @foreach (var evidence in result.MatchEvidence)
                {
                    <article class="screening-match">
                        <div class="screening-match-heading">
                            <h4>@evidence.MatchedName</h4>
                            <span class="screening-badge">
                                @evidence.SourceName
                            </span>
                        </div>

                        <div class="screening-match-percent">
                            <span>Name similarity</span>
                            <strong>
                                @evidence.NameMatchPercent.ToString("0.##")%
                            </strong>
                        </div>

                        <dl class="screening-evidence">
                            <div>
                                <dt>Match status</dt>
                                <dd>@evidence.MatchStatus</dd>
                            </div>

                            <div>
                                <dt>Overall match</dt>
                                <dd>
                                    @evidence.MatchPercent.ToString("0.##")%
                                </dd>
                            </div>

                            <div>
                                <dt>Reference</dt>
                                <dd>
                                    @(string.IsNullOrWhiteSpace(evidence.ReferenceNo)
                                        ? "Not provided"
                                        : evidence.ReferenceNo)
                                </dd>
                            </div>

                            <div>
                                <dt>Date of birth</dt>
                                <dd>
                                    @(evidence.DateOfBirthMatched
                                        ? "Matched"
                                        : "Not matched or unavailable")
                                </dd>
                            </div>

                            <div>
                                <dt>Country</dt>
                                <dd>
                                    @(evidence.CountryMatched
                                        ? "Matched"
                                        : "Not matched or unavailable")
                                </dd>
                            </div>

                            <div>
                                <dt>Gender</dt>
                                <dd>
                                    @(evidence.GenderMatched
                                        ? "Matched"
                                        : "Not matched or unavailable")
                                </dd>
                            </div>
                        </dl>
                    </article>
                }

                <details class="screening-details">
                    <summary>Risk calculation details</summary>

                    <div class="screening-table-wrap">
                        <table class="screening-table">
                            <thead>
                                <tr>
                                    <th scope="col">Factor</th>
                                    <th scope="col">Rule score</th>
                                    <th scope="col">Weight</th>
                                    <th scope="col">Points</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <th scope="row">AML source</th>
                                    <td>
                                        @(result.AmlRuleScore?.ToString("0.##") ?? "—")
                                    </td>
                                    <td>
                                        @(result.AmlWeight.HasValue
                                            ? result.AmlWeight.Value.ToString("0.##") + "%"
                                            : "—")
                                    </td>
                                    <td>
                                        @(result.AmlContribution?.ToString("0.##") ?? "—")
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row">Occupation</th>
                                    <td>
                                        @(result.OccupationRuleScore?.ToString("0.##") ?? "—")
                                    </td>
                                    <td>
                                        @(result.OccupationWeight.HasValue
                                            ? result.OccupationWeight.Value.ToString("0.##") + "%"
                                            : "—")
                                    </td>
                                    <td>
                                        @(result.OccupationContribution?.ToString("0.##") ?? "—")
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row">Source of funds</th>
                                    <td>
                                        @(result.SourceOfFundsRuleScore?.ToString("0.##") ?? "—")
                                    </td>
                                    <td>
                                        @(result.SourceOfFundsWeight.HasValue
                                            ? result.SourceOfFundsWeight.Value.ToString("0.##") + "%"
                                            : "—")
                                    </td>
                                    <td>
                                        @(result.SourceOfFundsContribution?.ToString("0.##") ?? "—")
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th scope="row" colspan="3">
                                        Final risk score
                                    </th>
                                    <td>
                                        @result.RiskScore.ToString("0.##")
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <p class="screening-note">
                        Points = rule score × weight ÷ 100.
                    </p>

                    <p class="screening-note">
                        Model version:
                        @(result.ModelVersion ?? "Not provided")
                    </p>

                    <p class="screening-note">
                        Customer DOB:
                        @(Model.DateOfBirth.HasValue
                            ? Model.DateOfBirth.Value.ToString(
                                "dd MMM yyyy",
                                CultureInfo.InvariantCulture)
                            : "Not provided")
                    </p>
                </details>
            }

            @* <p class="screening-note">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                <span>
                    Potential matches require review.
                    Name similarity and risk score are separate measures.
                    Results do not confirm identity or provide clearance.
                </span>
            </p> *@
        </section>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const form = document.getElementById("customerScreeningForm");
            const button = document.getElementById("screeningSubmit");
            const buttonText = document.getElementById("screeningButtonText");
            const resultPanel = document.getElementById("screeningResult");
            const status = document.getElementById("screeningStatus");

            form.addEventListener("submit", function (event) {
                if (!form.checkValidity()) {
                    return;
                }

                if (window.jQuery &&
                    jQuery.fn.valid &&
                    !jQuery(form).valid()) {
                    return;
                }

                if (event.defaultPrevented) {
                    return;
                }

                button.disabled = true;
                button.classList.add("is-loading");
                buttonText.textContent = "Checking...";
                resultPanel.setAttribute("aria-busy", "true");

                const title = document.getElementById("screeningEmptyTitle");
                const message = document.getElementById("screeningEmptyMessage");

                if (title && message) {
                    title.textContent = "Screening in progress";
                    message.textContent =
                        "Checking AML records and calculating the result.";
                } else {
                    status.textContent = "Screening in progress...";
                }
            });

            window.addEventListener("pageshow", function () {
                button.disabled = false;
                button.classList.remove("is-loading");
                buttonText.textContent = "Check PEP/Sanction";
                resultPanel.removeAttribute("aria-busy");
            });
        })();
    </script>
}