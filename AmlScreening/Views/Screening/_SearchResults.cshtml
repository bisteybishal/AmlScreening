@model AmlScreening.Portal.ViewModels.ScreeningSearchResultsViewModel

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        Search could not be completed. This is not a clear result.
        <div asp-validation-summary="All"></div>
    </div>
    return;
}

@if (string.IsNullOrWhiteSpace(Model.SearchName))
{
    return;
}

@if (Model.Results.Count == 0)
{
    <section class="screening-no-match">
        <div class="screening-no-match-icon"
             aria-hidden="true">
            <i class="bi bi-search"></i>
        </div>

        <div class="screening-no-match-content">
            <h3>No matching records found</h3>

            <ul class="screening-name-tags"
                aria-label="Name with no matches">
                <li>@Model.SearchName</li>
            </ul>

            <p>
                No active records matched this name
                within your permitted records.
            </p>

            <p class="screening-result-note">
                This is not a clearance decision.
            </p>
        </div>
    </section>
}
else
{
    @* <div class="live-results-heading">
        @if (Model.HasResults)
        {
            <p>
                Showing the first 50 matches.
                Type more characters to narrow the results.
            </p>
        }
        else
        {
            <p>
                @Model.Results.Count matching records
                for “@Model.SearchName”
            </p>
        }
    </div> *@

    @if (Model.HasMore)
    {
        <p>Showing the first 50 matches. Type more characters to narrow the results.</p>
    }
    <div class="screening-card-list">
        @foreach (var record in Model.Results)
        {
            var category = record.SourceName switch
            {
                "UN Sanctions" or "EU Sanctions" => "Sanctions",
                "PEP" or "PEP Local" or "PEP International" => "PEP",
                _ => "AML"
            };

            <details class="screening-card">
                <summary>
                   @* <span class="screening-record-icon">
                        <i class="bi bi-person"
                           aria-hidden="true"></i>
                    </span>*@
                    <span class="screening-record-icon">
                        @if (record.HasPhoto)
                        {
                            <img src="@Url.Action("GetPhoto", "Screening", new { id = record.Id })"
                                 alt="@record.FullName"
                                 class="screening-record-photo" />
                        }
                        else
                        {
                            <i class="bi bi-person"
                               aria-hidden="true"></i>
                        }
                    </span>

                    <span class="screening-record-heading">
                        <span class="screening-record-title">
                            <strong>@record.FullName</strong>

                            <span class="screening-category">
                                @category
                            </span>

                            <small>@record.RecordType</small>
                        </span>

                        <span class="screening-record-source">
                            @record.SourceName
                        </span>
                    </span>

                    <i class="bi bi-chevron-down screening-chevron"
                       aria-hidden="true"></i>
                </summary>

                <dl class="screening-detail-list">
                    <div>
                        <dt>Description</dt>
                        <dd>
                            @(string.IsNullOrWhiteSpace(record.Remarks)
                                ? "Not available"
                                : record.Remarks)
                        </dd>
                    </div>

                    <div>
                        <dt>Full name</dt>
                        <dd>@record.FullName</dd>
                    </div>

                    <div>
                        <dt>Record type</dt>
                        <dd>@record.RecordType</dd>
                    </div>

                    <div>
                        <dt>Date of birth</dt>
                        <dd>
                            @(record.DateOfBirth?.ToString("dd MMM yyyy")
                                ?? "Not available")
                        </dd>
                    </div>

                    <div>
                        <dt>Nationality</dt>
                        <dd>
                            @(string.IsNullOrWhiteSpace(record.Nationality)
                                ? "Not available"
                                : record.Nationality)
                        </dd>
                    </div>

                    <div>
                        <dt>Country</dt>
                        <dd>
                            @(string.IsNullOrWhiteSpace(record.Country)
                                ? "Not available"
                                : record.Country)
                        </dd>
                    </div>

                    <div>
                        <dt>Source</dt>
                        <dd>@record.SourceName</dd>
                    </div>

                    <div>
                        <dt>Reference number</dt>
                        <dd>@record.ReferenceNo</dd>
                    </div>
                </dl>
            </details>
        }
    </div>
}
