@model IReadOnlyList<AmlScreening.Domain.Entities.Compliance.AmlTransaction>
@{ ViewData["Title"] = "Transactions"; }
@section Styles { <link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" /> }
<section class="workflow-heading"><div><h1>AML Transactions</h1><p>Review API-submitted transactions, screening status and final AML decisions.</p></div></section>
<partial name="_WorkflowMessages" />
<section class="workflow-panel"><div class="workflow-panel-title"><h2>Transaction Register</h2><span>@Model.Count records</span></div><div class="table-responsive"><table class="workflow-table">
    <thead><tr><th>Reference</th><th>Parties</th><th>Amount</th><th>Date</th><th>Screening</th><th>Risk</th><th>Decision</th><th></th></tr></thead><tbody>
    @if (Model.Count == 0) { <tr><td colspan="8" class="workflow-empty">No transactions have been received from the AML API.</td></tr> }
    @foreach (var item in Model)
    {
        <tr><td><strong>@item.TransactionReference</strong><small>@item.Channel</small></td><td>@item.SenderName<small>To: @item.ReceiverName</small></td><td>@item.Amount.ToString("N2") @item.Currency</td><td>@item.TransactionDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@(item.ScreeningStatus ?? "Not evaluated")</td><td>@if (item.RiskScore.HasValue) { <span class="risk-pill @((item.RiskLevel ?? "low").ToLowerInvariant())">@item.RiskLevel (@item.RiskScore)</span> }</td><td><span class="decision-pill @((item.Decision ?? "new").ToLowerInvariant())">@(item.Decision ?? "NEW")</span></td><td><a asp-action="Details" asp-route-id="@item.Id">View</a></td></tr>
    }
    </tbody></table></div></section>
