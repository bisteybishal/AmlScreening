@model AmlScreening.Portal.ViewModels.TransactionDetailsViewModel
@{ var item = Model.Details.Transaction; ViewData["Title"] = "Transaction Details"; }
@section Styles { <link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" /> }
<section class="workflow-heading"><div><h1>@item.TransactionReference</h1><p>Correlation ID: @(item.CorrelationId ?? "Not assigned")</p></div><div class="workflow-heading-actions"><a class="workflow-secondary" asp-action="Index">Back</a>@if (item.Decision is null && User.HasClaim(AppPermissions.ClaimType, AppPermissions.TransactionsEvaluate)) { <form asp-action="Evaluate" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button class="workflow-primary" type="submit">Run AML Evaluation</button></form> }</div></section>
<partial name="_WorkflowMessages" />
<section class="decision-summary @((item.Decision ?? "new").ToLowerInvariant())"><div><small>Final Decision</small><strong>@(item.Decision ?? "NOT EVALUATED")</strong></div><div><small>Overall Risk</small><strong>@(item.RiskScore?.ToString() ?? "-") / 100</strong></div><div><small>Risk Level</small><strong>@(item.RiskLevel ?? "-")</strong></div><div><small>Screening</small><strong>@(item.ScreeningStatus ?? "-")</strong></div></section>
<div class="workflow-two-column">
    <section class="workflow-panel"><div class="workflow-panel-title"><h2>Transaction</h2></div><dl class="workflow-details"><dt>Customer</dt><dd>@Model.Details.Customer?.FullName</dd><dt>Sender</dt><dd>@item.SenderName</dd><dt>Receiver</dt><dd>@item.ReceiverName</dd><dt>Amount</dt><dd>@item.Amount.ToString("N2") @item.Currency</dd><dt>Route</dt><dd>@item.OriginCountry → @item.DestinationCountry</dd><dt>Channel</dt><dd>@item.Channel</dd></dl></section>
    <section class="workflow-panel"><div class="workflow-panel-title"><h2>Risk Assessment</h2></div>@if (Model.Details.RiskAssessment is { } risk) { <dl class="workflow-details"><dt>Customer risk</dt><dd>@risk.CustomerRiskScore</dd><dt>Transaction risk</dt><dd>@risk.TransactionRiskScore</dd><dt>Screening risk</dt><dd>@risk.ScreeningRiskScore</dd><dt>Overall risk</dt><dd>@risk.OverallRiskScore (@risk.RiskLevel)</dd><dt>Model</dt><dd>@risk.ModelVersion</dd></dl> } else { <p class="workflow-empty">Evaluation has not been run.</p> }</section>
</div>
<section class="workflow-panel"><div class="workflow-panel-title"><h2>Decision Reasons</h2></div><p>@(Model.Details.Decision?.Reasons ?? "No decision evidence is available.")</p>@if (Model.Details.Decision is { } decision) { <div class="evidence-line"><span>Rules: @decision.RuleVersions</span><span>Lists: @decision.ListVersions</span><span>Model: @decision.ModelVersion</span></div> }</section>
<section class="workflow-panel"><div class="workflow-panel-title"><h2>Screening Evidence</h2><span>@Model.Details.Matches.Count matches</span></div><div class="table-responsive"><table class="workflow-table"><thead><tr><th>Subject</th><th>Matched Record</th><th>Source</th><th>Score</th><th>Status</th><th>Compared Fields</th></tr></thead><tbody>@if (Model.Details.Matches.Count == 0) { <tr><td colspan="6" class="workflow-empty">No potential AML matches.</td></tr> } @foreach (var match in Model.Details.Matches) { <tr><td>@match.SubjectName</td><td>@match.MatchedName</td><td>@match.SourceName</td><td>@match.MatchScore.ToString("N2")%</td><td>@match.MatchStatus</td><td>@match.ComparedFields</td></tr> }</tbody></table></div></section>
