@model AmlScreening.Portal.ViewModels.TransactionInputModel
@{ ViewData["Title"] = "New Transaction"; }
@section Styles { <link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" /> }
<section class="workflow-heading"><div><h1>New AML Transaction</h1><p>Capture a transaction and run the complete screening, risk and decision workflow.</p></div></section>
<section class="workflow-panel workflow-form-panel"><form asp-action="Add" method="post">@Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="workflow-form-grid">
        <div><label asp-for="TransactionReference"></label><input asp-for="TransactionReference" /><span asp-validation-for="TransactionReference"></span></div>
        <div><label asp-for="CustomerId"></label><select asp-for="CustomerId"><option value="0">Select customer</option>@foreach (var customer in Model.Customers) { <option value="@customer.Id">@customer.CustomerReference - @customer.FullName</option> }</select><span asp-validation-for="CustomerId"></span></div>
        <div><label asp-for="SenderName"></label><input asp-for="SenderName" /><span asp-validation-for="SenderName"></span></div>
        <div><label asp-for="ReceiverName"></label><input asp-for="ReceiverName" /><span asp-validation-for="ReceiverName"></span></div>
        <div><label asp-for="Amount"></label><input asp-for="Amount" type="number" step="0.01" /><span asp-validation-for="Amount"></span></div>
        <div><label asp-for="Currency"></label><select asp-for="Currency"><option>NPR</option><option>USD</option><option>EUR</option><option>GBP</option></select></div>
        <div><label asp-for="OriginCountry"></label><input asp-for="OriginCountry" /><span asp-validation-for="OriginCountry"></span></div>
        <div><label asp-for="DestinationCountry"></label><input asp-for="DestinationCountry" /><span asp-validation-for="DestinationCountry"></span></div>
        <div><label asp-for="Channel"></label><select asp-for="Channel"><option>Branch</option><option>Mobile</option><option>Web</option><option>API</option><option>Agent</option></select></div>
        <div><label asp-for="TransactionDate"></label><input asp-for="TransactionDate" type="datetime-local" /></div>
        @if (User.HasClaim(AppPermissions.ClaimType, AppPermissions.TransactionsEvaluate)) { <label class="workflow-check full"><input asp-for="EvaluateImmediately" /><span>Run AML evaluation immediately after saving</span></label> }
    </div>
    <div class="workflow-form-actions"><a asp-action="Index">Cancel</a><button class="workflow-primary" type="submit">Save Transaction</button></div>
</form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
